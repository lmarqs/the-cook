diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..1ea0311
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,40 @@
+from larder.session_store import MemorySessions, sessions
+
+
+def test_missing_session_returns_none():
+    assert MemorySessions().get("missing") is None
+
+
+def test_put_creates_and_replaces_a_session():
+    store = MemorySessions()
+    store.put("member", {"cart": ["rice"]})
+    store.put("other", {})
+    store.put("member", {"cart": ["beans"]})
+
+    assert store.get("member") == {"cart": ["beans"]}
+    assert store.get("other") == {}
+
+
+def test_changes_are_only_saved_by_put():
+    store = MemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("member", data)
+    data["cart"].append("beans")
+    retrieved = store.get("member")
+    retrieved["cart"].append("flour")
+
+    assert store.get("member") == {"cart": ["rice"]}
+
+
+def test_separate_stores_do_not_share_sessions():
+    store = MemorySessions()
+    store.put("member", {"cart": ["rice"]})
+
+    assert MemorySessions().get("member") is None
+
+
+def test_process_store_is_shared_between_imports():
+    from larder.session_store import sessions as same_process_sessions
+
+    assert same_process_sessions is sessions
+    assert isinstance(sessions, MemorySessions)
