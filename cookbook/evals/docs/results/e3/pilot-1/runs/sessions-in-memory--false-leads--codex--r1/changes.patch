diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..2243eb4
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,34 @@
+from larder.session_store import InMemorySessions
+
+
+def test_missing_session():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_sessions_can_be_created_and_replaced():
+    store = InMemorySessions()
+    store.put("first", {"member_id": 1})
+    store.put("second", {"member_id": 2})
+    assert store.get("first") == {"member_id": 1}
+
+    store.put("first", {"member_id": 3})
+    assert store.get("first") == {"member_id": 3}
+    assert store.get("second") == {"member_id": 2}
+
+
+def test_changes_require_an_explicit_put():
+    store = InMemorySessions()
+    data = {"order": {"items": ["rice"]}}
+    store.put("session", data)
+    data["order"]["items"].append("beans")
+    retrieved = store.get("session")
+    retrieved["order"]["items"].append("lentils")
+
+    assert store.get("session") == {"order": {"items": ["rice"]}}
+
+
+def test_new_store_does_not_share_sessions():
+    store = InMemorySessions()
+    store.put("session", {"member_id": 1})
+
+    assert InMemorySessions().get("session") is None
