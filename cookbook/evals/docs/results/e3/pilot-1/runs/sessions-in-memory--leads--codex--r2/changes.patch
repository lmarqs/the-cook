diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..4229084
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,34 @@
+from larder.session_store import InMemorySessions
+
+
+def test_missing_session():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_replaces_the_session():
+    store = InMemorySessions()
+    store.put("member", {"items": ["rice"]})
+    store.put("member", {"items": ["beans"]})
+
+    assert store.get("member") == {"items": ["beans"]}
+
+
+def test_sessions_are_isolated():
+    store = InMemorySessions()
+    store.put("first", {"member_id": 1})
+    store.put("second", {})
+
+    assert store.get("first") == {"member_id": 1}
+    assert store.get("second") == {}
+    assert InMemorySessions().get("first") is None
+
+
+def test_changes_require_an_explicit_put():
+    store = InMemorySessions()
+    data = {"items": ["rice"]}
+    store.put("member", data)
+    data["items"].append("beans")
+    loaded = store.get("member")
+    loaded["items"].append("flour")
+
+    assert store.get("member") == {"items": ["rice"]}
