+++ b/tests/test_members.py
@@ -0,0 +1,47 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_orders_and_preserves_other_orders():
+    member = Member("member", "Member", "member@example.com", "Address")
+    other = Member("other", "Other", "other@example.com", "Other address")
+    other_order = StoredOrder("other-order", other.id, 200)
+    anonymous_order = StoredOrder("anonymous-order", None, 300)
+    store = Store(
+        members={member.id: member, other.id: other},
+        orders=[
+            StoredOrder("first", member.id, 100),
+            StoredOrder("second", member.id, 150),
+            other_order,
+            anonymous_order,
+            StoredOrder("last", member.id, 400),
+        ],
+    )
+    orders = store.orders
+
+    delete_member(member.id, store)
+
+    assert store.members == {other.id: other}
+    assert store.orders == [other_order, anonymous_order]
+    assert orders == [other_order, anonymous_order]
+
+
+def test_delete_member_without_orders():
+    member = Member("member", "Member", "member@example.com", "Address")
+    store = Store(members={member.id: member})
+
+    delete_member(member.id, store)
+
+    assert store.members == {}
+    assert store.orders == []
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("order", "missing", 100)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("missing", store)
+
+    assert store.orders == [order]
