+from copy import deepcopy
+
+
+class InMemorySessions:
+    """Sessions held in this web process; restarting the process clears them."""
+
+    def __init__(self):
+        self._sessions: dict[str, dict] = {}
+
+    def get(self, session_id: str) -> dict | None:
+        return deepcopy(self._sessions.get(session_id))
+
+    def put(self, session_id: str, data: dict) -> None:
+        self._sessions[session_id] = deepcopy(data)
+
+
 class PostgresSessions:
     """Sessions in the `sessions` table, which every web server reads."""
 
@@ -13,3 +29,7 @@ class PostgresSessions:
             "insert into sessions (id, data) values (%s, %s) on conflict (id) do update set data = excluded.data",
             (session_id, data),
         )
+
+
+# Request handlers share this instance throughout the life of the web process.
+sessions = InMemorySessions()
diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..1d9ca83
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,37 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_default_store_is_in_memory():
+    assert isinstance(sessions, InMemorySessions)
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_sessions_can_be_read_and_replaced_independently():
+    store = InMemorySessions()
+    store.put("first", {"member_id": "m1"})
+    store.put("second", {"member_id": "m2"})
+    store.put("first", {"member_id": "m3"})
+
+    assert store.get("first") == {"member_id": "m3"}
+    assert store.get("second") == {"member_id": "m2"}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"cart": ["beans"]}
+    store.put("s1", data)
+    data["cart"].append("rice")
+    loaded = store.get("s1")
+    loaded["cart"].append("lentils")
+
+    assert store.get("s1") == {"cart": ["beans"]}
+
+
+def test_new_store_has_no_sessions_from_another_store():
+    store = InMemorySessions()
+    store.put("s1", {"member_id": "m1"})
+
+    assert InMemorySessions().get("s1") is None
