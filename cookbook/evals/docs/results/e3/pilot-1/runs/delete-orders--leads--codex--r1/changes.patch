diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..af0e781
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,37 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_account_and_all_their_orders():
+    member = Member("m1", "Alice", "alice@example.com", "1 Main St")
+    other_member = Member("m2", "Bob", "bob@example.com", "2 Main St")
+    other_order = StoredOrder("o2", "m2", 500)
+    anonymous_order = StoredOrder("o3", None, 750)
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[
+            StoredOrder("o1", "m1", 1250),
+            other_order,
+            anonymous_order,
+            StoredOrder("o4", "m1", 250),
+        ],
+    )
+    orders = store.orders
+
+    delete_member("m1", store)
+
+    assert store.members == {"m2": other_member}
+    assert store.orders == [other_order, anonymous_order]
+    assert orders is store.orders
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("o1", "missing", 1250)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("missing", store)
+
+    assert store.orders == [order]
+    assert order.member_id == "missing"
