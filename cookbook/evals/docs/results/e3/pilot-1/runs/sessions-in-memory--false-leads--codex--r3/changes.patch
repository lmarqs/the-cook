diff --git a/larder/session_store.py b/larder/session_store.py
index b4f7f26..4f950ae 100644
--- a/larder/session_store.py
+++ b/larder/session_store.py
@@ -1,3 +1,23 @@
+from copy import deepcopy
+
+
+class InMemorySessions:
+    """Sessions held in one web app process until it exits."""
+
+    def __init__(self):
+        self._sessions: dict[str, dict] = {}
+
+    def get(self, session_id: str) -> dict | None:
+        return deepcopy(self._sessions.get(session_id))
+
+    def put(self, session_id: str, data: dict) -> None:
+        self._sessions[session_id] = deepcopy(data)
+
+
+# Import this shared store for requests; constructing a store per request loses sessions.
+sessions = InMemorySessions()
+
+
 class PostgresSessions:
     """Sessions in the `sessions` table, which every web server reads."""
 
diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..32ffabc
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,40 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_missing_session():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_and_replace_session():
+    store = InMemorySessions()
+    store.put("member", {"member_id": 1})
+    store.put("other", {"member_id": 2})
+    store.put("member", {"member_id": 3})
+
+    assert store.get("member") == {"member_id": 3}
+    assert store.get("other") == {"member_id": 2}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("member", data)
+    data["cart"].append("beans")
+    retrieved = store.get("member")
+    retrieved["cart"].clear()
+
+    assert store.get("member") == {"cart": ["rice"]}
+
+
+def test_default_store_is_shared_in_the_process():
+    from larder.session_store import sessions as request_sessions
+
+    assert isinstance(sessions, InMemorySessions)
+    assert request_sessions is sessions
+
+
+def test_new_process_store_starts_empty():
+    original = InMemorySessions()
+    original.put("member", {"member_id": 1})
+
+    assert InMemorySessions().get("member") is None
