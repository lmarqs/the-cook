+        self._sessions[session_id] = deepcopy(data)
+
+
+# Request handlers share this instance for the lifetime of the web process.
+sessions = InMemorySessions()
diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..ab1f846
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,40 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_creates_and_replaces_a_session():
+    store = InMemorySessions()
+    store.put("first", {"member_id": "alice"})
+    store.put("second", {})
+    store.put("first", {"member_id": "bob"})
+
+    assert store.get("first") == {"member_id": "bob"}
+    assert store.get("second") == {}
+
+
+def test_session_changes_require_an_explicit_put():
+    store = InMemorySessions()
+    data = {"order": {"items": ["rice"]}}
+    store.put("first", data)
+    data["order"]["items"].append("beans")
+    retrieved = store.get("first")
+    retrieved["order"]["items"].append("milk")
+
+    assert store.get("first") == {"order": {"items": ["rice"]}}
+
+
+def test_a_new_store_has_no_sessions_from_another_store():
+    store = InMemorySessions()
+    store.put("first", {"member_id": "alice"})
+
+    assert InMemorySessions().get("first") is None
+
+
+def test_request_handlers_can_import_the_same_process_store():
+    from larder.session_store import sessions as handler_sessions
+
+    assert handler_sessions is sessions
+    assert isinstance(sessions, InMemorySessions)
