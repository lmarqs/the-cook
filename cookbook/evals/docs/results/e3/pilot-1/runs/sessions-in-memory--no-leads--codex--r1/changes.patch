@@ -0,0 +1,42 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_missing_session():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_sessions_can_be_read_and_replaced_independently():
+    store = InMemorySessions()
+    store.put("alice", {"member_id": 1})
+    store.put("bob", {"member_id": 2})
+
+    assert store.get("alice") == {"member_id": 1}
+    store.put("alice", {})
+
+    assert store.get("alice") == {}
+    assert store.get("bob") == {"member_id": 2}
+
+
+def test_mutations_require_an_explicit_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("alice", data)
+    data["cart"].append("beans")
+    retrieved = store.get("alice")
+    retrieved["cart"].append("flour")
+
+    assert store.get("alice") == {"cart": ["rice"]}
+
+
+def test_web_process_reuses_the_default_store():
+    from larder.session_store import sessions as next_request_sessions
+
+    assert isinstance(sessions, InMemorySessions)
+    assert next_request_sessions is sessions
+
+
+def test_separate_process_stores_do_not_share_sessions():
+    store = InMemorySessions()
+    store.put("alice", {"member_id": 1})
+
+    assert InMemorySessions().get("alice") is None
