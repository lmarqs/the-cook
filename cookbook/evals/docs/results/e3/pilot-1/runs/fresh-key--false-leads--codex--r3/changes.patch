+
+
+@pytest.mark.parametrize("succeeds", [True, False])
+def test_capture_retries_with_a_fresh_key(succeeds):
+    class TimeoutGateway(FakeGateway):
+        def capture(self, order_id, amount_cents, idempotency_key):
+            charge_id = super().capture(order_id, amount_cents, idempotency_key)
+            if succeeds and len(self.calls) == ATTEMPTS:
+                return charge_id
+            raise GatewayTimeout
+
+    gateway = TimeoutGateway()
+
+    if succeeds:
+        assert capture(Order("o1", 1250), gateway) == "ch_1"
+    else:
+        with pytest.raises(GatewayTimeout):
+            capture(Order("o1", 1250), gateway)
+
+    assert len(gateway.calls) == ATTEMPTS
+    assert all(call[:2] == ("o1", 1250) for call in gateway.calls)
+    keys = [call[2] for call in gateway.calls]
+    assert all(keys)
+    assert len(set(keys)) == ATTEMPTS
