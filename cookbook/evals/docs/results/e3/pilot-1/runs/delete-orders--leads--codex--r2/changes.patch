diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..f54a853
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,22 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_deleting_a_member_removes_their_orders_and_preserves_other_records():
+    member = Member("member", "Member", "member@example.com", "Address")
+    other_member = Member("other", "Other", "other@example.com", "Other address")
+    other_order = StoredOrder("other-order", other_member.id, 300)
+    anonymous_order = StoredOrder("anonymous-order", None, 400)
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[
+            StoredOrder("first", member.id, 100),
+            StoredOrder("second", member.id, 200),
+            other_order,
+            anonymous_order,
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other_member.id: other_member}
+    assert store.orders == [other_order, anonymous_order]
