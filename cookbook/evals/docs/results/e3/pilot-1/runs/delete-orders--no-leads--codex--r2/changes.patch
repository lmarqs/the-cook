diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..37113aa
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,32 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_account_and_all_their_orders():
+    member = Member("m1", "Alice", "alice@example.com", "1 Main Street")
+    other_member = Member("m2", "Bob", "bob@example.com", "2 Main Street")
+    other_order = StoredOrder("o2", "m2", 2000)
+    anonymous_order = StoredOrder("o3", None, 3000)
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[
+            StoredOrder("o1", "m1", 1000),
+            other_order,
+            anonymous_order,
+            StoredOrder("o4", "m1", 4000),
+            StoredOrder("o5", "m1", 5000),
+        ],
+    )
+
+    delete_member("m1", store)
+
+    assert store.members == {"m2": other_member}
+    assert store.orders == [other_order, anonymous_order]
+
+
+def test_delete_member_without_orders():
+    store = Store(members={"m1": Member("m1", "Alice", "alice@example.com", "1 Main Street")})
+
+    delete_member("m1", store)
+
+    assert store.members == {}
+    assert store.orders == []
