diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..106ae99
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,32 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_replaces_only_the_given_session():
+    store = InMemorySessions()
+    store.put("first", {"member_id": 1})
+    store.put("second", {"member_id": 2})
+    store.put("first", {"member_id": 3})
+
+    assert store.get("first") == {"member_id": 3}
+    assert store.get("second") == {"member_id": 2}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"order": {"items": ["rice"]}}
+    store.put("member", data)
+    data["order"]["items"].append("beans")
+    loaded = store.get("member")
+    loaded["order"]["items"].clear()
+
+    assert store.get("member") == {"order": {"items": ["rice"]}}
+
+
+def test_requests_can_share_the_process_store():
+    from larder.session_store import sessions as next_request_sessions
+
+    assert next_request_sessions is sessions
