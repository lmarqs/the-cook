diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..360155c
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,44 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_orders_and_preserves_other_records():
+    member = Member("m1", "Ana", "ana@example.com", "1 Main St")
+    other_member = Member("m2", "Tom", "tom@example.com", "2 Main St")
+    other_order = StoredOrder("o2", "m2", 500)
+    anonymous_order = StoredOrder("o4", None, 750)
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[
+            StoredOrder("o1", "m1", 1000),
+            other_order,
+            StoredOrder("o3", "m1", 1250),
+            anonymous_order,
+            StoredOrder("o5", "m1", 250),
+        ],
+    )
+
+    delete_member("m1", store)
+
+    assert store.members == {"m2": other_member}
+    assert store.orders == [other_order, anonymous_order]
+
+
+def test_delete_member_without_orders():
+    store = Store(members={"m1": Member("m1", "Ana", "ana@example.com", "1 Main St")})
+
+    delete_member("m1", store)
+
+    assert store.members == {}
+    assert store.orders == []
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("o1", "m1", 1000)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("m1", store)
+
+    assert store.orders == [order]
