diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..4a55581
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,40 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_unknown_session_is_missing():
+    assert InMemorySessions().get("unknown") is None
+
+
+def test_put_replaces_only_the_named_session():
+    store = InMemorySessions()
+    store.put("member", {"member_id": 1})
+    store.put("other", {})
+    store.put("member", {"member_id": 2})
+
+    assert store.get("member") == {"member_id": 2}
+    assert store.get("other") == {}
+
+
+def test_changes_are_saved_only_by_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("member", data)
+    data["cart"].append("beans")
+    retrieved = store.get("member")
+    retrieved["cart"].append("milk")
+
+    assert store.get("member") == {"cart": ["rice"]}
+
+
+def test_default_store_is_shared_by_importers():
+    from larder import session_store
+
+    assert session_store.sessions is sessions
+    assert isinstance(sessions, InMemorySessions)
+
+
+def test_new_stores_have_no_previous_sessions():
+    store = InMemorySessions()
+    store.put("member", {"member_id": 1})
+
+    assert InMemorySessions().get("member") is None
