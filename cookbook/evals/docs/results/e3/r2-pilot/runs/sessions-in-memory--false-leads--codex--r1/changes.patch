--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,26 @@
+from larder.session_store import InMemorySessions
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_creates_and_replaces_only_the_named_session():
+    store = InMemorySessions()
+    store.put("first", {"member_id": "one"})
+    store.put("second", {})
+    store.put("first", {"member_id": "two"})
+
+    assert store.get("first") == {"member_id": "two"}
+    assert store.get("second") == {}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"order": {"items": ["rice"]}}
+    store.put("member", data)
+    data["order"]["items"].append("beans")
+    retrieved = store.get("member")
+    retrieved["order"]["items"].clear()
+
+    assert store.get("member") == {"order": {"items": ["rice"]}}
