diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..1b352d2
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,24 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_orders_and_preserves_other_records():
+    member = Member("member", "Member", "member@example.com", "1 Main Street")
+    other = Member("other", "Other", "other@example.com", "2 Main Street")
+    other_order = StoredOrder("other-order", other.id, 300)
+    anonymous_order = StoredOrder("anonymous-order", None, 400)
+    store = Store(
+        members={member.id: member, other.id: other},
+        orders=[
+            StoredOrder("first", member.id, 100),
+            StoredOrder("second", member.id, 200),
+            other_order,
+            anonymous_order,
+            StoredOrder("third", member.id, 500),
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other.id: other}
+    assert store.orders == [other_order, anonymous_order]
+    assert other_order.member_id == other.id
