@@ -0,0 +1,41 @@
+from larder import sessions
+from larder.session_store import InMemorySessions
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_stores_and_replaces_only_the_named_session():
+    store = InMemorySessions()
+    store.put("first", {"member_id": 1})
+    store.put("second", {})
+    store.put("first", {"member_id": 2})
+
+    assert store.get("first") == {"member_id": 2}
+    assert store.get("second") == {}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"cart": ["beans"]}
+    store.put("member", data)
+    data["cart"].append("rice")
+    retrieved = store.get("member")
+    retrieved["cart"].clear()
+
+    assert store.get("member") == {"cart": ["beans"]}
+
+
+def test_new_store_has_no_sessions_from_a_previous_store():
+    previous = InMemorySessions()
+    previous.put("member", {"member_id": 1})
+
+    assert InMemorySessions().get("member") is None
+
+
+def test_default_session_store_is_shared_in_memory():
+    from larder.sessions import store
+
+    assert isinstance(store, InMemorySessions)
+    assert sessions.store is store
