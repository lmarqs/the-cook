diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..41b7733
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,33 @@
+from larder.session_store import InMemorySessions
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_put_replaces_only_the_named_session():
+    store = InMemorySessions()
+    store.put("one", {"member_id": "alice"})
+    store.put("two", {"member_id": "bob"})
+    store.put("one", {})
+
+    assert store.get("one") == {}
+    assert store.get("two") == {"member_id": "bob"}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("one", data)
+    data["cart"].append("beans")
+    loaded = store.get("one")
+    loaded["cart"].append("flour")
+
+    assert store.get("one") == {"cart": ["rice"]}
+
+
+def test_separate_stores_do_not_share_sessions():
+    store = InMemorySessions()
+    store.put("one", {"member_id": "alice"})
+
+    assert InMemorySessions().get("one") is None
