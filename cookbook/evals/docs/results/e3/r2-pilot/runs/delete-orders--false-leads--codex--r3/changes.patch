diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..270c0d4
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,45 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_orders_and_preserves_other_data():
+    member = Member("m1", "Ana", "ana@example.com", "1 Main St")
+    other = Member("m2", "Tom", "tom@example.com", "2 Main St")
+    other_order = StoredOrder("o2", "m2", 500)
+    anonymous_order = StoredOrder("o3", None, 750)
+    store = Store(
+        members={member.id: member, other.id: other},
+        orders=[
+            StoredOrder("o1", member.id, 100),
+            StoredOrder("o4", member.id, 200),
+            other_order,
+            anonymous_order,
+            StoredOrder("o5", member.id, 300),
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other.id: other}
+    assert store.orders == [other_order, anonymous_order]
+
+
+def test_delete_member_without_orders():
+    member = Member("m1", "Ana", "ana@example.com", "1 Main St")
+    store = Store(members={member.id: member})
+
+    delete_member(member.id, store)
+
+    assert store.members == {}
+    assert store.orders == []
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("o1", "missing", 100)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("missing", store)
+
+    assert store.orders == [order]
