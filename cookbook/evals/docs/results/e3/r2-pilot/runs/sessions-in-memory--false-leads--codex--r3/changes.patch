diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..8b71b0f
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,35 @@
+from larder.session_store import MemorySessions, sessions
+
+
+def test_sessions_can_be_created_read_and_replaced():
+    store = MemorySessions()
+
+    assert store.get("missing") is None
+    store.put("first", {"member_id": 1})
+    store.put("second", {})
+    assert store.get("first") == {"member_id": 1}
+    assert store.get("second") == {}
+
+    store.put("first", {"member_id": 2})
+    assert store.get("first") == {"member_id": 2}
+    assert store.get("second") == {}
+
+
+def test_session_changes_are_only_saved_by_put():
+    store = MemorySessions()
+    data = {"order": {"items": ["rice"]}}
+    store.put("member", data)
+    data["order"]["items"].append("beans")
+    retrieved = store.get("member")
+    assert retrieved == {"order": {"items": ["rice"]}}
+
+    retrieved["order"]["items"].clear()
+    assert store.get("member") == {"order": {"items": ["rice"]}}
+
+
+def test_web_process_has_a_shared_store():
+    from larder.session_store import sessions as same_sessions
+
+    assert isinstance(sessions, MemorySessions)
+    assert same_sessions is sessions
+    assert MemorySessions().get("member") is None
