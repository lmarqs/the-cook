diff --git a/tests/test_session_store.py b/tests/test_session_store.py
new file mode 100644
index 0000000..9357074
--- /dev/null
+++ b/tests/test_session_store.py
@@ -0,0 +1,34 @@
+from larder.session_store import InMemorySessions, sessions
+
+
+def test_missing_session():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_sessions_can_be_read_and_replaced_independently():
+    store = InMemorySessions()
+    store.put("alice", {"cart": ["rice"]})
+    store.put("bob", {})
+    assert store.get("alice") == {"cart": ["rice"]}
+    assert store.get("bob") == {}
+
+    store.put("alice", {"cart": ["beans"]})
+    assert store.get("alice") == {"cart": ["beans"]}
+    assert store.get("bob") == {}
+    assert InMemorySessions().get("alice") is None
+
+
+def test_mutating_session_data_requires_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("alice", data)
+    data["cart"].append("beans")
+    fetched = store.get("alice")
+    fetched["cart"].append("lentils")
+    assert store.get("alice") == {"cart": ["rice"]}
+
+
+def test_default_store_is_shared_by_importers():
+    from larder.session_store import sessions as another_request_store
+
+    assert another_request_store is sessions
