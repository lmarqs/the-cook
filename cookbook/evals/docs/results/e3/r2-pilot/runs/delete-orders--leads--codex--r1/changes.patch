@@ -0,0 +1,32 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+@pytest.mark.parametrize("order_count", [0, 2])
+def test_delete_member_removes_their_orders_and_preserves_other_records(order_count):
+    member = Member("m1", "Ana", "ana@example.com", "1 Pantry Street")
+    other_member = Member("m2", "Tom", "tom@example.com", "2 Pantry Street")
+    other_order = StoredOrder("other", other_member.id, 700)
+    anonymous_order = StoredOrder("anonymous", None, 800)
+    member_orders = [StoredOrder(f"o{i}", member.id, 500) for i in range(order_count)]
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[other_order, *member_orders, anonymous_order],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other_member.id: other_member}
+    assert store.orders == [other_order, anonymous_order]
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("o1", "missing", 500)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("missing", store)
+
+    assert store.orders == [order]
+    assert order.member_id == "missing"
