@@ -0,0 +1,41 @@
+from larder.session_store import InMemorySessions, session_store
+
+
+def test_missing_session_returns_none():
+    assert InMemorySessions().get("missing") is None
+
+
+def test_sessions_can_be_created_and_replaced_independently():
+    store = InMemorySessions()
+    store.put("one", {"member_id": "alice"})
+    store.put("two", {})
+    store.put("one", {"member_id": "bob"})
+
+    assert store.get("one") == {"member_id": "bob"}
+    assert store.get("two") == {}
+
+
+def test_session_changes_require_put():
+    store = InMemorySessions()
+    data = {"cart": ["rice"]}
+    store.put("one", data)
+    data["cart"].append("beans")
+    loaded = store.get("one")
+    loaded["cart"].append("milk")
+
+    assert store.get("one") == {"cart": ["rice"]}
+
+
+def test_new_store_has_no_sessions_from_previous_store():
+    store = InMemorySessions()
+    store.put("one", {"member_id": "alice"})
+
+    assert InMemorySessions().get("one") is None
+
+
+def test_default_store_is_shared_across_imports():
+    from larder.session_store import session_store as another_request_store
+
+    session_store.put("shared", {"member_id": "alice"})
+
+    assert another_request_store.get("shared") == {"member_id": "alice"}
