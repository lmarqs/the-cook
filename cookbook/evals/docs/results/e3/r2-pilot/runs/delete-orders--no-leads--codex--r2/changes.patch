+++ b/tests/test_members.py
@@ -0,0 +1,46 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_removes_their_orders_and_preserves_other_data():
+    member = Member("m1", "Alice", "alice@example.com", "1 Main St")
+    other_member = Member("m2", "Bob", "bob@example.com", "2 Main St")
+    other_order = StoredOrder("o2", "m2", 500)
+    anonymous_order = StoredOrder("o3", None, 700)
+    store = Store(
+        members={"m1": member, "m2": other_member},
+        orders=[
+            StoredOrder("o1", "m1", 1000),
+            StoredOrder("o4", "m1", 1200),
+            other_order,
+            anonymous_order,
+        ],
+    )
+    orders = store.orders
+
+    delete_member("m1", store)
+
+    assert store.members == {"m2": other_member}
+    assert store.orders == [other_order, anonymous_order]
+    assert orders is store.orders
+
+
+def test_delete_member_without_orders():
+    store = Store(members={"m1": Member("m1", "Alice", "alice@example.com", "1 Main St")})
+
+    delete_member("m1", store)
+
+    assert store.members == {}
+    assert store.orders == []
+
+
+def test_delete_missing_member_leaves_orders_unchanged():
+    order = StoredOrder("o1", "m1", 1000)
+    store = Store(orders=[order])
+
+    with pytest.raises(KeyError):
+        delete_member("m1", store)
+
+    assert store.orders == [order]
+    assert order.member_id == "m1"
