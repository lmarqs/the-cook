@@ -0,0 +1,25 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_deleting_a_member_keeps_their_orders_without_identifying_them():
+    member = Member("member", "Alice", "alice@example.com", "1 Main Street")
+    other = Member("other", "Bob", "bob@example.com", "2 Main Street")
+    store = Store(
+        members={member.id: member, other.id: other},
+        orders=[
+            StoredOrder("first", member.id, 500),
+            StoredOrder("second", other.id, 700),
+            StoredOrder("third", member.id, 900),
+            StoredOrder("fourth", None, 300),
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other.id: other}
+    assert store.orders == [
+        StoredOrder("first", None, 500),
+        StoredOrder("second", other.id, 700),
+        StoredOrder("third", None, 900),
+        StoredOrder("fourth", None, 300),
+    ]
