diff --git a/tests/test_capture.py b/tests/test_capture.py
index 32c7093..5846d1c 100644
--- a/tests/test_capture.py
+++ b/tests/test_capture.py
@@ -1,4 +1,7 @@
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +19,48 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+class FailingGateway(FakeGateway):
+    def __init__(self, failures, error):
+        super().__init__()
+        self.failures = failures
+        self.error = error
+
+    def capture(self, order_id, amount_cents, idempotency_key):
+        charge_id = super().capture(order_id, amount_cents, idempotency_key)
+        if len(self.calls) <= self.failures:
+            raise self.error
+        return charge_id
+
+
+@pytest.mark.parametrize("failures", [1, 2])
+def test_capture_retries_timeouts_with_the_same_key(failures):
+    gateway = FailingGateway(failures, GatewayTimeout())
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+    assert len(gateway.calls) == failures + 1
+    assert all(call == gateway.calls[0] for call in gateway.calls)
+
+
+def test_capture_propagates_timeout_after_three_attempts():
+    error = GatewayTimeout()
+    gateway = FailingGateway(3, error)
+
+    with pytest.raises(GatewayTimeout) as exc:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc.value is error
+    assert len(gateway.calls) == 3
+    assert all(call == gateway.calls[0] for call in gateway.calls)
+
+
+def test_capture_does_not_retry_other_errors():
+    error = ValueError("capture failed")
+    gateway = FailingGateway(3, error)
+
+    with pytest.raises(ValueError) as exc:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc.value is error
+    assert len(gateway.calls) == 1
