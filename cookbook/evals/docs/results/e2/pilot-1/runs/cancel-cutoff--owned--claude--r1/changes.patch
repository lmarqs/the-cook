diff --git a/tests/test_cancellation.py b/tests/test_cancellation.py
new file mode 100644
index 0000000..fa629aa
--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,21 @@
+from datetime import datetime, timedelta
+
+from larder.cancellation import can_cancel
+
+PICKUP = datetime(2026, 10, 30, 18, 0)
+
+
+def test_can_cancel_well_before_cutoff():
+    assert can_cancel(PICKUP, PICKUP - timedelta(days=1))
+
+
+def test_can_cancel_at_cutoff():
+    assert can_cancel(PICKUP, PICKUP - timedelta(hours=2))
+
+
+def test_cannot_cancel_after_cutoff():
+    assert not can_cancel(PICKUP, PICKUP - timedelta(hours=2) + timedelta(seconds=1))
+
+
+def test_cannot_cancel_after_pickup_starts():
+    assert not can_cancel(PICKUP, PICKUP + timedelta(minutes=5))
