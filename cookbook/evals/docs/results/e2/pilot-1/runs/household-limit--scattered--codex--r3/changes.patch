+++ b/tests/test_limits.py
@@ -0,0 +1,26 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize("count, expected", [(0, True), (1, True), (2, False), (3, False)])
+def test_household_open_order_limit(count, expected):
+    member = Member("m1", "Alice", "1 Main Street")
+
+    assert can_place_order(member, [member], {member.id: count}) is expected
+
+
+def test_orders_are_counted_across_members_at_the_same_address():
+    member = Member("m1", "Alice", "1 Main Street")
+    housemate = Member("m2", "Bob", member.address)
+
+    assert not can_place_order(member, [member, housemate], {housemate.id: 2})
+    assert not can_place_order(member, [member, housemate], {member.id: 1, housemate.id: 1})
+
+
+def test_other_households_do_not_count_toward_the_limit():
+    member = Member("m1", "Alice", "1 Main Street")
+    neighbor = Member("m2", "Bob", "2 Main Street")
+
+    assert can_place_order(member, [member, neighbor], {neighbor.id: 2})
