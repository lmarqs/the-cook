--- /dev/null
+++ b/tests/test_limits.py
@@ -0,0 +1,23 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "allowed"),
+    [
+        ({}, True),
+        ({"member": 1}, True),
+        ({"member": 2}, False),
+        ({"member": 1, "housemate": 1}, False),
+        ({"housemate": 3}, False),
+        ({"neighbor": 2}, True),
+    ],
+)
+def test_order_limit_is_shared_by_members_at_the_same_address(open_orders, allowed):
+    member = Member("member", "Alex", "10 Main Street")
+    housemate = Member("housemate", "Sam", "10 Main Street")
+    neighbor = Member("neighbor", "Jo", "12 Main Street")
+
+    assert can_place_order(member, [member, housemate, neighbor], open_orders) is allowed
