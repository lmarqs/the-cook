--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,22 @@
+from datetime import datetime, timedelta
+
+from larder.cancellation import CUTOFF_HOURS, can_cancel
+
+PICKUP = datetime(2026, 1, 1, 12, 0)
+CUTOFF = PICKUP - timedelta(hours=CUTOFF_HOURS)
+
+
+def test_a_member_can_cancel_before_the_cutoff():
+    assert can_cancel(PICKUP, CUTOFF - timedelta(minutes=1))
+
+
+def test_a_member_can_cancel_at_the_cutoff():
+    assert can_cancel(PICKUP, CUTOFF)
+
+
+def test_a_member_cannot_cancel_after_the_cutoff():
+    assert not can_cancel(PICKUP, CUTOFF + timedelta(minutes=1))
+
+
+def test_a_member_cannot_cancel_once_pickup_has_started():
+    assert not can_cancel(PICKUP, PICKUP)
