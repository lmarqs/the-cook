diff --git a/larder/members.py b/larder/members.py
index 408f67a..bd0d107 100644
--- a/larder/members.py
+++ b/larder/members.py
@@ -25,5 +25,11 @@ class Store:
 
 
 def delete_member(member_id: str, store: Store) -> None:
-    """Deletes a member's account when they ask for it."""
-    raise NotImplementedError
+    """Deletes a member's account when they ask for it.
+
+    Their pantry orders stay, with no member, for the grant's order counts: see docs/features/accounts.md.
+    """
+    store.members.pop(member_id, None)
+    for order in store.orders:
+        if order.member_id == member_id:
+            order.member_id = None
diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..4a859c2
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,16 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_delete_member_keeps_their_orders_without_them():
+    store = Store(
+        members={
+            "m1": Member("m1", "Ana", "ana@example.org", "1 Elm St"),
+            "m2": Member("m2", "Bo", "bo@example.org", "2 Oak St"),
+        },
+        orders=[StoredOrder("o1", "m1", 1200), StoredOrder("o2", "m2", 800), StoredOrder("o3", "m1", 500)],
+    )
+
+    delete_member("m1", store)
+
+    assert list(store.members) == ["m2"]
+    assert [(o.id, o.member_id) for o in store.orders] == [("o1", None), ("o2", "m2"), ("o3", None)]
