+++ b/tests/test_limits.py
@@ -0,0 +1,25 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "allowed"),
+    [
+        ({}, True),
+        ({"m1": 1}, True),
+        ({"m2": 1}, True),
+        ({"m1": 2}, False),
+        ({"m2": 2}, False),
+        ({"m1": 1, "m2": 1}, False),
+        ({"m1": 3}, False),
+        ({"m3": 2}, True),
+    ],
+)
+def test_order_limit_counts_all_members_at_the_same_address(open_orders, allowed):
+    member = Member("m1", "Alex", "1 Pantry Street")
+    housemate = Member("m2", "Sam", "1 Pantry Street")
+    neighbour = Member("m3", "Taylor", "2 Pantry Street")
+
+    assert can_place_order(member, [member, housemate, neighbour], open_orders) is allowed
