diff --git a/larder/limits.py b/larder/limits.py
index a5807f9..a75e0f6 100644
--- a/larder/limits.py
+++ b/larder/limits.py
@@ -4,4 +4,9 @@ from larder.members import Member
 def can_place_order(member: Member, members: list[Member], open_orders: dict[str, int]) -> bool:
     """Whether `member` may place another pantry order. `members` are every registered member, and `open_orders`
     counts each member's pantry orders not yet picked up or cancelled, by member id."""
-    raise NotImplementedError
+    household_orders = sum(
+        open_orders.get(registered_member.id, 0)
+        for registered_member in members
+        if registered_member.address == member.address
+    )
+    return household_orders < 2
diff --git a/tests/test_limits.py b/tests/test_limits.py
new file mode 100644
index 0000000..6250c84
