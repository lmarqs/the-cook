+++ b/tests/test_limits.py
@@ -0,0 +1,26 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize("count, allowed", [(0, True), (1, True), (2, False), (3, False)])
+def test_household_order_limit(count, allowed):
+    member = Member("m1", "Alex", "1 Main Street")
+
+    assert can_place_order(member, [member], {member.id: count}) is allowed
+
+
+def test_orders_are_counted_across_household_members():
+    member = Member("m1", "Alex", "1 Main Street")
+    housemate = Member("m2", "Sam", member.address)
+
+    assert not can_place_order(member, [member, housemate], {housemate.id: 2})
+    assert not can_place_order(member, [member, housemate], {member.id: 1, housemate.id: 1})
+
+
+def test_other_households_do_not_use_the_members_allowance():
+    member = Member("m1", "Alex", "1 Main Street")
+    neighbour = Member("m2", "Sam", "2 Main Street")
+
+    assert can_place_order(member, [member, neighbour], {neighbour.id: 2})
