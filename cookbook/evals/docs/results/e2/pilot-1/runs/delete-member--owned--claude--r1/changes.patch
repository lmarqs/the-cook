@@ -25,5 +25,11 @@ class Store:
 
 
 def delete_member(member_id: str, store: Store) -> None:
-    """Deletes a member's account when they ask for it."""
-    raise NotImplementedError
+    """Deletes a member's account when they ask for it.
+
+    Their pantry orders stay, with no member: see docs/features/accounts.md#deletion.
+    """
+    for order in store.orders:
+        if order.member_id == member_id:
+            order.member_id = None
+    del store.members[member_id]
diff --git a/tests/test_members.py b/tests/test_members.py
new file mode 100644
index 0000000..16f51b5
--- /dev/null
+++ b/tests/test_members.py
@@ -0,0 +1,38 @@
+import pytest
+
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def make_store() -> Store:
+    store = Store()
+    store.members["m1"] = Member("m1", "Ada", "ada@example.org", "1 Elm St")
+    store.members["m2"] = Member("m2", "Bo", "bo@example.org", "2 Oak St")
+    store.orders = [
+        StoredOrder("o1", "m1", 1200),
+        StoredOrder("o2", "m2", 800),
+        StoredOrder("o3", "m1", 500),
+    ]
+    return store
+
+
+def test_delete_member_removes_the_member():
+    store = make_store()
+    delete_member("m1", store)
+    assert "m1" not in store.members
+    assert "m2" in store.members
+
+
+def test_delete_member_keeps_their_orders_without_them():
+    store = make_store()
+    delete_member("m1", store)
+    assert [(o.id, o.member_id, o.amount_cents) for o in store.orders] == [
+        ("o1", None, 1200),
+        ("o2", "m2", 800),
+        ("o3", None, 500),
+    ]
+
+
+def test_delete_unknown_member_raises():
+    store = make_store()
+    with pytest.raises(KeyError):
+        delete_member("nobody", store)
