+++ b/tests/test_limits.py
@@ -0,0 +1,24 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "allowed"),
+    [
+        ({}, True),
+        ({"member": 1}, True),
+        ({"member": 2}, False),
+        ({"housemate": 2}, False),
+        ({"member": 1, "housemate": 1}, False),
+        ({"member": 2, "housemate": 1}, False),
+        ({"neighbor": 2}, True),
+    ],
+)
+def test_order_limit_counts_all_orders_at_the_members_address(open_orders, allowed):
+    member = Member("member", "Alex", "1 Main Street")
+    housemate = Member("housemate", "Sam", "1 Main Street")
+    neighbor = Member("neighbor", "Jo", "2 Main Street")
+
+    assert can_place_order(member, [member, housemate, neighbor], open_orders) is allowed
