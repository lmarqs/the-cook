@@ -0,0 +1,22 @@
+from datetime import datetime, timedelta
+
+import pytest
+
+from larder.cancellation import can_cancel
+
+
+@pytest.mark.parametrize(
+    ("offset", "expected"),
+    [
+        (timedelta(microseconds=-1), True),
+        (timedelta(0), True),
+        (timedelta(microseconds=1), False),
+        (timedelta(hours=2), False),
+        (timedelta(hours=3), False),
+    ],
+)
+def test_cancellation_cutoff(offset, expected):
+    pickup_starts = datetime(2026, 1, 1, 12, 0)
+    cutoff = pickup_starts - timedelta(hours=2)
+
+    assert can_cancel(pickup_starts, cutoff + offset) is expected
