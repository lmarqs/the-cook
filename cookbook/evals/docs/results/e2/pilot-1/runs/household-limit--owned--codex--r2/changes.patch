@@ -0,0 +1,28 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "allowed"),
+    [
+        ({}, True),
+        ({"other": 2}, True),
+        ({"member": 1}, True),
+        ({"housemate": 1}, True),
+        ({"member": 2}, False),
+        ({"housemate": 2}, False),
+        ({"member": 1, "housemate": 1}, False),
+        ({"member": 2, "housemate": 1}, False),
+    ],
+)
+def test_order_limit_is_shared_by_members_at_the_same_address(open_orders, allowed):
+    member = Member("member", "Alex", "1 Pantry Street")
+    members = [
+        member,
+        Member("housemate", "Sam", "1 Pantry Street"),
+        Member("other", "Robin", "2 Pantry Street"),
+    ]
+
+    assert can_place_order(member, members, open_orders) is allowed
