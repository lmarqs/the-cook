@@ -0,0 +1,25 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_deleting_a_member_keeps_their_orders_without_identifying_them():
+    member = Member("member-1", "Alex", "alex@example.com", "1 Main St")
+    other_member = Member("member-2", "Sam", "sam@example.com", "2 Main St")
+    store = Store(
+        members={member.id: member, other_member.id: other_member},
+        orders=[
+            StoredOrder("order-1", member.id, 500),
+            StoredOrder("order-2", other_member.id, 700),
+            StoredOrder("order-3", member.id, 900),
+            StoredOrder("order-4", None, 300),
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other_member.id: other_member}
+    assert store.orders == [
+        StoredOrder("order-1", None, 500),
+        StoredOrder("order-2", other_member.id, 700),
+        StoredOrder("order-3", None, 900),
+        StoredOrder("order-4", None, 300),
+    ]
