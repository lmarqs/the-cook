diff --git a/tests/test_pantry.py b/tests/test_pantry.py
new file mode 100644
index 0000000..630e811
--- /dev/null
+++ b/tests/test_pantry.py
@@ -0,0 +1,17 @@
+from larder.pantry import Line, PantryOrder, amount_cents
+
+
+def test_amount_uses_confirmed_prices_when_catalog_prices_change():
+    order = PantryOrder("o1", (Line("rice", 2, 350), Line("beans", 3, 200)))
+
+    assert amount_cents(order, {"rice": 500, "beans": 150}) == 1300
+
+
+def test_amount_preserves_prices_for_items_removed_from_the_catalog():
+    order = PantryOrder("o1", (Line("rice", 2, 350),))
+
+    assert amount_cents(order, {}) == 700
+
+
+def test_empty_order_has_zero_amount():
+    assert amount_cents(PantryOrder("o1", ()), {"rice": 500}) == 0
