diff --git a/tests/test_capture.py b/tests/test_capture.py
index 32c7093..f6ab53a 100644
--- a/tests/test_capture.py
+++ b/tests/test_capture.py
@@ -1,4 +1,9 @@
+from unittest.mock import Mock
+
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +21,43 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+@pytest.mark.parametrize("timeouts", [1, 2])
+def test_capture_retries_timeouts_with_the_same_idempotency_key(timeouts):
+    gateway = Mock()
+    gateway.capture.side_effect = [GatewayTimeout() for _ in range(timeouts)] + ["ch_1"]
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+
+    calls = gateway.capture.call_args_list
+    assert len(calls) == timeouts + 1
+    assert calls[0].args == ("o1", 1250)
+    assert calls[0].kwargs["idempotency_key"]
+    assert all(call == calls[0] for call in calls)
+
+
+def test_capture_propagates_the_third_timeout():
+    gateway = Mock()
+    timeouts = [GatewayTimeout() for _ in range(3)]
+    gateway.capture.side_effect = timeouts
+
+    with pytest.raises(GatewayTimeout) as exc:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc.value is timeouts[-1]
+    calls = gateway.capture.call_args_list
+    assert len(calls) == 3
+    assert all(call == calls[0] for call in calls)
+
+
+def test_capture_does_not_retry_other_errors():
+    gateway = Mock()
+    error = ValueError("capture declined")
+    gateway.capture.side_effect = error
+
+    with pytest.raises(ValueError) as exc:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc.value is error
+    gateway.capture.assert_called_once()
