diff --git a/tests/test_capture.py b/tests/test_capture.py
index 32c7093..87f8348 100644
--- a/tests/test_capture.py
+++ b/tests/test_capture.py
@@ -1,13 +1,20 @@
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
 class FakeGateway:
-    def __init__(self):
+    def __init__(self, failures=()):
         self.calls = []
+        self.failures = iter(failures)
 
     def capture(self, order_id, amount_cents, idempotency_key):
         self.calls.append((order_id, amount_cents, idempotency_key))
+        failure = next(self.failures, None)
+        if failure is not None:
+            raise failure
         return "ch_1"
 
 
@@ -16,3 +23,32 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+def test_capture_retries_timeouts_with_the_same_idempotency_key():
+    gateway = FakeGateway([GatewayTimeout(), GatewayTimeout()])
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+    assert len(gateway.calls) == 3
+    assert gateway.calls == [gateway.calls[0]] * 3
+
+
+def test_capture_propagates_the_third_timeout():
+    final_timeout = GatewayTimeout("still unavailable")
+    gateway = FakeGateway([GatewayTimeout(), GatewayTimeout(), final_timeout])
+
+    with pytest.raises(GatewayTimeout) as error:
+        capture(Order("o1", 1250), gateway)
+
+    assert error.value is final_timeout
+    assert len(gateway.calls) == 3
+    assert gateway.calls == [gateway.calls[0]] * 3
+
+
+def test_capture_does_not_retry_other_errors():
+    gateway = FakeGateway([ValueError("declined")])
+
+    with pytest.raises(ValueError, match="declined"):
+        capture(Order("o1", 1250), gateway)
+
+    assert len(gateway.calls) == 1
