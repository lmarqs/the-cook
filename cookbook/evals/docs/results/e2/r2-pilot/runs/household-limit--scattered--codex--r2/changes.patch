+++ b/tests/test_limits.py
@@ -0,0 +1,24 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "expected"),
+    [
+        ({}, True),
+        ({"m1": 1}, True),
+        ({"m1": 2}, False),
+        ({"m1": 3}, False),
+        ({"m1": 1, "m2": 1}, False),
+        ({"m2": 2}, False),
+        ({"m3": 2}, True),
+    ],
+)
+def test_household_may_order_only_below_two_open_orders(open_orders, expected):
+    member = Member("m1", "Alice", "1 Main Street")
+    housemate = Member("m2", "Bob", "1 Main Street")
+    neighbor = Member("m3", "Carol", "2 Main Street")
+
+    assert can_place_order(member, [member, housemate, neighbor], open_orders) is expected
