@@ -1,7 +1,19 @@
+import re
+
 from larder.members import Member
 
 
+def _household_address(address: str) -> tuple[str, ...]:
+    abbreviations = {"st": "street", "rd": "road"}
+    return tuple(abbreviations.get(part, part) for part in re.findall(r"\w+", address.lower()))
+
+
 def can_place_order(member: Member, members: list[Member], open_orders: dict[str, int]) -> bool:
     """Whether `member` may place another pantry order. `members` are every registered member, and `open_orders`
     counts each member's pantry orders not yet picked up or cancelled, by member id."""
-    raise NotImplementedError
+    address = _household_address(member.address)
+    return sum(
+        open_orders.get(registered.id, 0)
+        for registered in members
+        if _household_address(registered.address) == address
+    ) < 2
diff --git a/tests/test_limits.py b/tests/test_limits.py
new file mode 100644
index 0000000..7ba713b
--- /dev/null
+++ b/tests/test_limits.py
@@ -0,0 +1,36 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize("count, allowed", [(0, True), (1, True), (2, False), (3, False)])
+def test_household_order_limit(count, allowed):
+    member = Member("m1", "Alex", "12 Main Street, Flat 1")
+
+    assert can_place_order(member, [member], {member.id: count}) is allowed
+
+
+def test_orders_are_counted_across_members_with_normalized_addresses():
+    member = Member("m1", "Alex", "12 Main Street, Flat 1")
+    housemate = Member("m2", "Sam", "12 MAIN ST., FLAT 1")
+
+    assert not can_place_order(member, [member, housemate], {"m1": 1, "m2": 1})
+
+
+def test_road_abbreviations_match_and_missing_counts_default_to_zero():
+    member = Member("m1", "Alex", "12 Main Road")
+    housemate = Member("m2", "Sam", "12 Main Rd.")
+
+    assert not can_place_order(member, [member, housemate], {"m2": 2})
+    assert can_place_order(member, [member, housemate], {})
+
+
+def test_other_flats_and_street_numbers_are_separate_households():
+    member = Member("m1", "Alex", "12 Main Street, Flat 3")
+    neighbor = Member("m2", "Alex", "12 Main Street, Flat 4")
+    other_house = Member("m3", "Alex", "1 Main Street, Flat 23")
+
+    assert can_place_order(
+        member, [member, neighbor, other_house], {"m2": 2, "m3": 2, "unknown": 2}
+    )
