@@ -0,0 +1,30 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    ("open_orders", "allowed"),
+    [
+        ({}, True),
+        ({"m1": 1}, True),
+        ({"m2": 1}, True),
+        ({"m1": 2}, False),
+        ({"m2": 2}, False),
+        ({"m1": 1, "m2": 1}, False),
+        ({"m1": 3}, False),
+    ],
+)
+def test_open_order_limit_is_shared_by_household(open_orders, allowed):
+    member = Member("m1", "Ana Silva", "10 main street flat 1")
+    housemate = Member("m2", "Jo Costa", member.address)
+
+    assert can_place_order(member, [member, housemate], open_orders) is allowed
+
+
+def test_orders_at_another_address_do_not_count():
+    member = Member("m1", "Ana Silva", "10 main street flat 1")
+    neighbour = Member("m2", "Leo Silva", "10 main street flat 2")
+
+    assert can_place_order(member, [member, neighbour], {"m1": 1, "m2": 2})
