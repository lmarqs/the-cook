@@ -0,0 +1,19 @@
+from larder.pantry import Line, PantryOrder, amount_cents
+
+
+def test_amount_cents_sums_quantity_times_line_price():
+    order = PantryOrder(
+        "o1",
+        (
+            Line("rice", 2, 150),
+            Line("beans", 3, 100),
+        ),
+    )
+
+    assert amount_cents(order, catalog={}) == 2 * 150 + 3 * 100
+
+
+def test_amount_cents_ignores_the_catalog_s_current_price():
+    order = PantryOrder("o1", (Line("rice", 1, 150),))
+
+    assert amount_cents(order, catalog={"rice": 999}) == 150
