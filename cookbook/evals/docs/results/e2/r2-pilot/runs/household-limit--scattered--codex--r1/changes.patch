@@ -0,0 +1,24 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize("household_orders, allowed", [(0, True), (1, True), (2, False), (3, False)])
+def test_household_may_hold_at_most_two_open_orders(household_orders, allowed):
+    member = Member("alice", "Alice", "1 Pantry Lane")
+    housemate = Member("bob", "Bob", "1 Pantry Lane")
+    neighbor = Member("carol", "Carol", "2 Pantry Lane")
+
+    assert can_place_order(
+        member,
+        [member, housemate, neighbor],
+        {housemate.id: household_orders, neighbor.id: 10},
+    ) is allowed
+
+
+def test_orders_are_counted_across_household_members():
+    member = Member("alice", "Alice", "1 Pantry Lane")
+    housemate = Member("bob", "Bob", "1 Pantry Lane")
+
+    assert not can_place_order(member, [member, housemate], {member.id: 1, housemate.id: 1})
