@@ -0,0 +1,33 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize("count, allowed", [(0, True), (1, True), (2, False), (3, False)])
+def test_household_open_order_limit(count, allowed):
+    member = Member("m1", "Alex", "12 Main Street")
+
+    assert can_place_order(member, [member], {member.id: count}) is allowed
+
+
+@pytest.mark.parametrize("street, abbreviation", [("Street", "St."), ("Road", "Rd")])
+def test_orders_are_combined_across_normalized_household_addresses(street, abbreviation):
+    member = Member("m1", "Alex", f"12 Main {street}, Flat 1")
+    housemate = Member("m2", "Sam", f"  12 MAIN {abbreviation}  FLAT 1  ")
+
+    assert not can_place_order(member, [member, housemate], {"m1": 1, "m2": 1})
+
+
+@pytest.mark.parametrize("address", ["12 Main Street Flat 2", "13 Main Street Flat 1", "12 Other Street Flat 1"])
+def test_other_households_do_not_count_even_with_the_same_name(address):
+    member = Member("m1", "Alex", "12 Main Street Flat 1")
+    neighbour = Member("m2", "Alex", address)
+
+    assert can_place_order(member, [member, neighbour], {"m2": 2})
+
+
+def test_missing_order_counts_default_to_zero():
+    member = Member("m1", "Alex", "12 Main Street")
+
+    assert can_place_order(member, [member], {})
