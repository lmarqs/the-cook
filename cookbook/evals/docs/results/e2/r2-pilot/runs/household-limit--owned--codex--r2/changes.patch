+import string
+
 from larder.members import Member
 
 
+def _household_address(address: str) -> tuple[str, ...]:
+    address = address.lower().translate(str.maketrans("", "", string.punctuation))
+    abbreviations = {"st": "street", "rd": "road"}
+    return tuple(abbreviations.get(part, part) for part in address.split())
+
+
 def can_place_order(member: Member, members: list[Member], open_orders: dict[str, int]) -> bool:
     """Whether `member` may place another pantry order. `members` are every registered member, and `open_orders`
     counts each member's pantry orders not yet picked up or cancelled, by member id."""
-    raise NotImplementedError
+    address = _household_address(member.address)
+    household_ids = {
+        registered.id
+        for registered in members
+        if _household_address(registered.address) == address
+    }
+    household_ids.add(member.id)
+    return sum(open_orders.get(member_id, 0) for member_id in household_ids) < 2
