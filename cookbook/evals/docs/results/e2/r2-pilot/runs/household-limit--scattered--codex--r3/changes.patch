@@ -0,0 +1,24 @@
+import pytest
+
+from larder.limits import can_place_order
+from larder.members import Member
+
+
+@pytest.mark.parametrize(
+    "open_orders, allowed",
+    [
+        ({}, True),
+        ({"alice": 1}, True),
+        ({"bob": 1}, True),
+        ({"alice": 2}, False),
+        ({"alice": 1, "bob": 1}, False),
+        ({"bob": 3}, False),
+        ({"carol": 5}, True),
+    ],
+)
+def test_order_limit_applies_to_all_members_at_the_same_address(open_orders, allowed):
+    alice = Member("alice", "Alice", "1 Pantry Street")
+    bob = Member("bob", "Bob", "1 Pantry Street")
+    carol = Member("carol", "Carol", "2 Pantry Street")
+
+    assert can_place_order(alice, [alice, bob, carol], open_orders) is allowed
