@@ -0,0 +1,36 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_deleting_a_member_keeps_their_orders_without_their_identity():
+    member = Member("member-1", "Alice", "alice@example.com", "1 Main Street")
+    other = Member("member-2", "Bob", "bob@example.com", "2 Main Street")
+    store = Store(
+        members={member.id: member, other.id: other},
+        orders=[
+            StoredOrder("order-1", member.id, 500),
+            StoredOrder("order-2", other.id, 700),
+            StoredOrder("order-3", member.id, 900),
+            StoredOrder("order-4", None, 300),
+        ],
+    )
+
+    delete_member(member.id, store)
+
+    assert store.members == {other.id: other}
+    assert store.orders == [
+        StoredOrder("order-1", None, 500),
+        StoredOrder("order-2", other.id, 700),
+        StoredOrder("order-3", None, 900),
+        StoredOrder("order-4", None, 300),
+    ]
+
+
+def test_deleting_a_member_without_orders_can_be_repeated():
+    member = Member("member-1", "Alice", "alice@example.com", "1 Main Street")
+    store = Store(members={member.id: member})
+
+    delete_member(member.id, store)
+    delete_member(member.id, store)
+
+    assert store.members == {}
+    assert store.orders == []
