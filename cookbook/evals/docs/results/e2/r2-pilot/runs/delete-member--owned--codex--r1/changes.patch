@@ -0,0 +1,36 @@
+from larder.members import Member, Store, StoredOrder, delete_member
+
+
+def test_deleting_a_member_preserves_and_anonymizes_their_orders():
+    member = Member("m1", "Alex", "alex@example.com", "1 Main Street")
+    other_member = Member("m2", "Sam", "sam@example.com", "2 Main Street")
+    orders = [
+        StoredOrder("o1", "m1", 1250),
+        StoredOrder("o2", "m2", 500),
+        StoredOrder("o3", "m1", 750),
+        StoredOrder("o4", None, 250),
+    ]
+    store = Store(members={"m1": member, "m2": other_member}, orders=orders)
+
+    delete_member("m1", store)
+
+    assert store.members == {"m2": other_member}
+    assert store.orders == [
+        StoredOrder("o1", None, 1250),
+        StoredOrder("o2", "m2", 500),
+        StoredOrder("o3", None, 750),
+        StoredOrder("o4", None, 250),
+    ]
+
+
+def test_deleting_a_member_twice_is_harmless():
+    store = Store(
+        members={"m1": Member("m1", "Alex", "alex@example.com", "1 Main Street")},
+        orders=[StoredOrder("o1", "m1", 1250)],
+    )
+
+    delete_member("m1", store)
+    delete_member("m1", store)
+
+    assert store.members == {}
+    assert store.orders == [StoredOrder("o1", None, 1250)]
