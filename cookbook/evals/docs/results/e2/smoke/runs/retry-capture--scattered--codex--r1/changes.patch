diff --git a/tests/test_capture.py b/tests/test_capture.py
index 32c7093..edf4d5a 100644
--- a/tests/test_capture.py
+++ b/tests/test_capture.py
@@ -1,4 +1,7 @@
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +19,49 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+class FailingGateway(FakeGateway):
+    def __init__(self, failures):
+        super().__init__()
+        self.failures = iter(failures)
+
+    def capture(self, order_id, amount_cents, idempotency_key):
+        charge_id = super().capture(order_id, amount_cents, idempotency_key)
+        failure = next(self.failures, None)
+        if failure is not None:
+            raise failure
+        return charge_id
+
+
+@pytest.mark.parametrize("timeouts", [1, 2])
+def test_capture_retries_timeouts_with_the_same_idempotency_key(timeouts):
+    gateway = FailingGateway([GatewayTimeout() for _ in range(timeouts)])
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+    assert len(gateway.calls) == timeouts + 1
+    assert gateway.calls[0][2]
+    assert all(call == gateway.calls[0] for call in gateway.calls)
+
+
+def test_capture_propagates_the_third_timeout():
+    failures = [GatewayTimeout() for _ in range(3)]
+    gateway = FailingGateway(failures)
+
+    with pytest.raises(GatewayTimeout) as exc_info:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc_info.value is failures[-1]
+    assert len(gateway.calls) == 3
+    assert all(call == gateway.calls[0] for call in gateway.calls)
+
+
+def test_capture_does_not_retry_other_errors():
+    failure = ValueError("capture rejected")
+    gateway = FailingGateway([failure])
+
+    with pytest.raises(ValueError) as exc_info:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc_info.value is failure
+    assert len(gateway.calls) == 1
