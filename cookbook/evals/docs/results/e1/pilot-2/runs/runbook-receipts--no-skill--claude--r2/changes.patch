+#!/usr/bin/env bash
+# Starts the stopped worker and watches its queue of receipt jobs drain.
+# The steps and what to do when this fails: docs/runbooks/receipts-stopped.md.
+set -euo pipefail
+
+jobs_by_status() {
+  psql larder -c "select status, count(*) from procrastinate_jobs group by status order by status"
+}
+
+todo_jobs() {
+  psql larder -At -c "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+echo "== The worker"
+# systemctl status exits non-zero when the unit is not running; that is the case this script handles.
+systemctl status larder-worker --no-pager || true
+
+echo "== Jobs waiting"
+jobs_by_status
+
+if systemctl is-active --quiet larder-worker; then
+  echo "The worker is already running, so this is not the stopped-worker case."
+  echo "Follow 'If it fails' in docs/runbooks/receipts-stopped.md."
+  exit 1
+fi
+
+echo "== Starting the worker"
+sudo systemctl start larder-worker
+
+while true; do
+  sleep 60
+  if ! systemctl is-active --quiet larder-worker; then
+    echo "The worker stopped again. Its last 50 log lines:"
+    journalctl -u larder-worker -n 50 --no-pager
+    exit 1
+  fi
+  todo=$(todo_jobs)
+  echo "$(date +%H:%M) todo: $todo"
+  if [ "$todo" -eq 0 ]; then
+    break
+  fi
+done
+
+echo "== Done; jobs by status"
+jobs_by_status
