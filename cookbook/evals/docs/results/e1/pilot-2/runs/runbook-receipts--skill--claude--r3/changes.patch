+#!/usr/bin/env bash
+# Starts the receipts worker if it is down and waits until its queue drains.
+# Runbook: docs/runbooks/receipts-stopped.md
+set -euo pipefail
+
+count_jobs() {
+  psql larder -At -F ' ' -c "select status, count(*) from procrastinate_jobs group by status order by status"
+}
+
+todo_jobs() {
+  psql larder -At -c "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+echo "== worker"
+systemctl status larder-worker --no-pager --lines=0 || true
+
+echo "== jobs waiting"
+count_jobs
+
+if ! systemctl is-active --quiet larder-worker; then
+  echo "== starting larder-worker"
+  sudo systemctl start larder-worker
+fi
+
+while true; do
+  sleep 60
+  if ! systemctl is-active --quiet larder-worker; then
+    echo "== larder-worker stopped again; its last 50 log lines:"
+    journalctl -u larder-worker -n 50 --no-pager
+    exit 1
+  fi
+  todo=$(todo_jobs)
+  echo "$(date +%H:%M) todo: $todo"
+  if [ "$todo" -eq 0 ]; then
+    echo "== queue drained"
+    count_jobs
+    exit 0
+  fi
+done
