+++ b/scripts/restart-receipt-worker.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# Brings receipt emails back when the worker is down: shows the queue, starts the worker and waits until no job is
+# left to do. Run on the larder server. Runbook: docs/runbooks/receipts-stopped.md
+set -euo pipefail
+
+unit=larder-worker
+counts="select status, count(*) from procrastinate_jobs group by status order by status"
+todo="select count(*) from procrastinate_jobs where status = 'todo'"
+
+if systemctl is-active --quiet "$unit"; then
+  echo "$unit is already running; this script does not apply. See 'If it fails' in the runbook."
+  psql larder -c "$counts"
+  exit 1
+fi
+
+systemctl status "$unit" --no-pager --lines=0 || true
+echo
+echo "Jobs before starting the worker:"
+psql larder -c "$counts"
+
+sudo systemctl start "$unit"
+echo "Started $unit. Checking the queue every minute until no job is left to do."
+
+while true; do
+  sleep 60
+  if ! systemctl is-active --quiet "$unit"; then
+    echo "$unit stopped again. Its last 50 log lines:"
+    journalctl -u "$unit" -n 50 --no-pager
+    exit 1
+  fi
+  left=$(psql larder -tAc "$todo")
+  echo "$(date +%H:%M) todo: $left"
+  if [ "$left" -eq 0 ]; then
+    break
+  fi
+done
+
+echo
+echo "Queue drained. Jobs now:"
+psql larder -c "$counts"
