+#!/usr/bin/env bash
+# Brings the receipts worker back and watches it drain the queue.
+# Runbook: docs/runbooks/receipts-stopped.md
+set -euo pipefail
+
+count_jobs() {
+  psql larder -c "select status, count(*) from procrastinate_jobs group by status"
+}
+
+todo_jobs() {
+  psql larder -tAc "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+echo "== Worker status"
+systemctl status larder-worker --no-pager || true
+
+echo "== Jobs waiting"
+count_jobs
+
+if systemctl is-active --quiet larder-worker; then
+  echo "== The worker is running; this script has nothing to restart."
+  exit 0
+fi
+
+echo "== Starting the worker"
+sudo systemctl start larder-worker
+
+while true; do
+  sleep 60
+  if ! systemctl is-active --quiet larder-worker; then
+    echo "== The worker died again. Its last 50 log lines:"
+    journalctl -u larder-worker -n 50 --no-pager
+    exit 1
+  fi
+  todo=$(todo_jobs)
+  echo "$(date +%H:%M) todo: $todo"
+  if [ "$todo" -eq 0 ]; then
+    break
+  fi
+done
+
+echo "== Queue drained"
+count_jobs
