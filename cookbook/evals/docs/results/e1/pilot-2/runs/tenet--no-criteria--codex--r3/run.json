      "command": "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\ncount = 0\nfor page in Path('docs').rglob('*.md'):\n    for target in re.findall(r'\\[[^\\]]+\\]\\(([^)]+)\\)', page.read_text()):\n        if '://' in target:\n            continue\n        filename, _, anchor = target.partition('#')\n        dest = page.parent / filename if filename else page\n        assert dest.is_file(), (page, target)\n        if anchor:\n            headings = re.findall(r'^#+ (.+)$', dest.read_text(), re.M)\n            anchors = [re.sub(r'[^\\w\\- ]', '', h.lower()).replace(' ', '-') for h in headings]\n            assert anchor in anchors, (page, target)\n        count += 1\nprint(f'Checked {count} local documentation links and anchors.')\nPY"
