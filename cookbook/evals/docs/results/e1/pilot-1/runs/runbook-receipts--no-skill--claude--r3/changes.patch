+#!/usr/bin/env bash
+# Starts the stopped receipts worker and waits until the receipts queued meanwhile are sent.
+# Run it on the larder server; docs/runbooks/receipts-stopped.md says when and what to do if it fails.
+set -euo pipefail
+
+unit=larder-worker
+interval=${INTERVAL_SECONDS:-60}
+stalled_limit=5
+
+jobs_by_status() {
+  psql larder -XAtF ' ' -c "select status, count(*) from procrastinate_jobs group by status order by status"
+}
+
+todo_count() {
+  psql larder -XAt -c "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+show_log() {
+  echo
+  echo "Last 50 lines of the worker's log:"
+  journalctl -u "$unit" -n 50 --no-pager
+}
+
+state=$(systemctl is-active "$unit" || true)
+echo "Worker: $state"
+echo "Jobs by status:"
+jobs_by_status
+
+if [[ $state == active ]]; then
+  echo
+  echo "The worker is already running, so restarting it will not help. See 'If it fails' in the runbook."
+  show_log
+  exit 1
+fi
+
+echo
+echo "Starting the worker."
+sudo systemctl start "$unit"
+
+last=$(todo_count)
+stalled=0
+echo "Waiting for todo to reach 0, checking every $interval seconds. todo: $last"
+while (( last > 0 )); do
+  sleep "$interval"
+  if [[ $(systemctl is-active "$unit" || true) != active ]]; then
+    echo
+    echo "The worker stopped again."
+    show_log
+    exit 1
+  fi
+  todo=$(todo_count)
+  echo "todo: $todo"
+  if (( todo < last )); then
+    stalled=0
+  else
+    stalled=$((stalled + 1))
+    if (( stalled >= stalled_limit )); then
+      echo
+      echo "todo has not gone down for $stalled checks."
+      show_log
+      exit 1
+    fi
+  fi
+  last=$todo
+done
+
+echo
+echo "Done: the worker is running and no receipts are waiting."
+jobs_by_status
