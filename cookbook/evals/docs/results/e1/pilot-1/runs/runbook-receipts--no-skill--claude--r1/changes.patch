+#!/usr/bin/env bash
+# Brings receipts back when the worker has stopped: the steps of docs/runbooks/receipts-stopped.md.
+# Run it on the server where larder runs, as a user who can run `sudo systemctl` and `psql larder`.
+set -euo pipefail
+trap 'echo "Failed: \`$BASH_COMMAND\` (line $LINENO). Follow '"'"'If it fails'"'"' in docs/runbooks/receipts-stopped.md." >&2' ERR
+
+unit=larder-worker
+interval=30       # seconds between checks of the queue
+stall_checks=6    # checks in a row without progress before giving up (3 minutes)
+
+count_todo() {
+    psql larder -tAc "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+show_logs_and_fail() {
+    echo
+    echo "$1"
+    echo "Last 50 lines of the worker's log:"
+    journalctl -u "$unit" -n 50 --no-pager
+    echo
+    echo "Stop here and follow 'If it fails' in docs/runbooks/receipts-stopped.md."
+    exit 1
+}
+
+# 1. Is the worker running?
+echo "== Worker status"
+if systemctl is-active --quiet "$unit"; then
+    systemctl status "$unit" --no-pager || true
+    echo
+    echo "The worker is running, so it is not the cause; this script cannot help."
+    echo "Follow 'If it fails' in docs/runbooks/receipts-stopped.md."
+    exit 1
+fi
+systemctl status "$unit" --no-pager || true
+
+# 2. What is waiting?
+echo
+echo "== Jobs in the queue, by status"
+psql larder -c "select status, count(*) from procrastinate_jobs group by status"
+
+# 3. Start the worker.
+echo
+echo "== Starting $unit"
+sudo systemctl start "$unit"
+
+# 4. Watch the waiting jobs go to 0.
+echo
+echo "== Waiting jobs, every ${interval}s (Ctrl-C stops watching; the worker keeps running)"
+best=$(count_todo)
+echo "$(date +%H:%M:%S)  todo: $best"
+stalled=0
+while [ "$best" -gt 0 ]; do
+    sleep "$interval"
+    if ! systemctl is-active --quiet "$unit"; then
+        show_logs_and_fail "The worker stopped again after it was started."
+    fi
+    todo=$(count_todo)
+    echo "$(date +%H:%M:%S)  todo: $todo"
+    if [ "$todo" -lt "$best" ]; then
+        best=$todo
+        stalled=0
+    else
+        stalled=$((stalled + 1))
+        if [ "$stalled" -ge "$stall_checks" ]; then
+            show_logs_and_fail "The worker is running but the waiting jobs have not gone down for 3 minutes."
+        fi
+    fi
+done
+
+echo
+echo "== Done: no jobs waiting. Final count by status:"
+psql larder -c "select status, count(*) from procrastinate_jobs group by status"
