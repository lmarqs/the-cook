@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Starts the stopped worker and waits until the queued receipts are sent.
+# Run on the server; the steps it follows are in docs/runbooks/receipts-stopped.md.
+set -euo pipefail
+
+count_todo() {
+  psql larder -tAc "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+echo "Jobs waiting, by status:"
+psql larder -c "select status, count(*) from procrastinate_jobs group by status"
+
+if systemctl is-active --quiet larder-worker; then
+  echo "The worker is already running, so it is not what stopped receipts. Its last log lines:"
+  sudo journalctl -u larder-worker -n 50 --no-pager
+  exit 1
+fi
+
+echo "The worker is stopped; starting it."
+sudo systemctl start larder-worker
+
+while true; do
+  sleep 60
+  if ! systemctl is-active --quiet larder-worker; then
+    echo "The worker stopped again. Its last log lines:"
+    sudo journalctl -u larder-worker -n 50 --no-pager
+    exit 1
+  fi
+  todo=$(count_todo)
+  echo "$(date +%H:%M) jobs waiting: $todo"
+  if [ "$todo" -eq 0 ]; then
+    echo "Done: every queued receipt has been sent."
+    exit 0
+  fi
+done
