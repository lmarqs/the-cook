+#!/bin/sh
+# Starts the receipts worker if it is down, then waits for its queue to drain.
+# The runbook docs/runbooks/receipts-stopped.md says when to run it and what to do if it fails.
+set -eu
+
+count_todo() {
+    psql larder -tAc "select count(*) from procrastinate_jobs where status = 'todo'"
+}
+
+echo "Jobs waiting, by status:"
+psql larder -c "select status, count(*) from procrastinate_jobs group by status"
+
+if systemctl is-active --quiet larder-worker; then
+    echo "larder-worker is already running, so it is not the cause. Follow 'If it fails' in the runbook."
+    exit 1
+fi
+
+echo "larder-worker is down; starting it."
+sudo systemctl start larder-worker
+
+todo=$(count_todo)
+while [ "$todo" -gt 0 ]; do
+    echo "todo: $todo"
+    sleep 60
+    if ! systemctl is-active --quiet larder-worker; then
+        echo "larder-worker died again. Its last 50 log lines:"
+        journalctl -u larder-worker -n 50 --no-pager
+        exit 1
+    fi
+    todo=$(count_todo)
+done
+echo "todo: 0. Receipts are flowing again."
