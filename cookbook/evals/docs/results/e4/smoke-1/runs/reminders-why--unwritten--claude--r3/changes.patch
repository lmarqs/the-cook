@@ -0,0 +1,11 @@
+from larder.reminders import remind
+
+
+def test_a_pickup_reminder_goes_by_email_not_sms():
+    sms, email = [], []
+
+    remind("+351900000000", "member@example.org", "tomorrow at 10:00",
+           lambda *args: sms.append(args), lambda *args: email.append(args))
+
+    assert sms == []
+    assert email == [("member@example.org", "Your pantry order is ready for pickup tomorrow at 10:00.")]
