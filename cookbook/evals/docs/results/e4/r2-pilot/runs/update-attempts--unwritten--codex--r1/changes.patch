+import time
+
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +21,32 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+@pytest.mark.parametrize("timeouts", [1, 2, 3])
+def test_capture_retries_immediately_with_the_same_key(monkeypatch, timeouts):
+    class TimeoutGateway(FakeGateway):
+        def capture(self, order_id, amount_cents, idempotency_key):
+            result = super().capture(order_id, amount_cents, idempotency_key)
+            if len(self.calls) <= timeouts:
+                raise GatewayTimeout("gateway did not answer")
+            return result
+
+    def unexpected_sleep(seconds):
+        pytest.fail("capture must retry without pausing")
+
+    monkeypatch.setattr(time, "sleep", unexpected_sleep)
+    gateway = TimeoutGateway()
+    order = Order("o1", 1250)
+
+    if timeouts == 3:
+        with pytest.raises(GatewayTimeout):
+            capture(order, gateway)
+    else:
+        assert capture(order, gateway) == "ch_1"
+
+    assert len(gateway.calls) == min(timeouts + 1, 3)
+    assert all(call[:2] == ("o1", 1250) for call in gateway.calls)
+    keys = {call[2] for call in gateway.calls}
+    assert len(keys) == 1
+    assert next(iter(keys))
