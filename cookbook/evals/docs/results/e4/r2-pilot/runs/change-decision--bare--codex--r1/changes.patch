+from datetime import datetime, timedelta, timezone
 
-from larder.sessions import EXPIRY_MINUTES, expires_at
+import pytest
+
+from larder.sessions import EXPIRY_MINUTES, expires_at, logout, sign, verify
 
 
 def test_a_session_ends_after_the_expiry_without_a_request():
     start = datetime(2026, 1, 1, 12, 0)
 
     assert expires_at(start) == start + timedelta(minutes=EXPIRY_MINUTES)
+
+
+def test_targeted_logout_explicitly_fails_without_revoking_any_cookies():
+    start = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+    stolen_cookie = sign(1, start)
+    other_cookie = sign(2, start)
+
+    with pytest.raises(NotImplementedError, match="shared, persistent revocation state"):
+        logout(1)
+
+    assert verify(stolen_cookie, now=start) == 1
+    assert verify(other_cookie, now=start) == 2
+    assert verify(stolen_cookie, now=start + timedelta(minutes=31)) is None
