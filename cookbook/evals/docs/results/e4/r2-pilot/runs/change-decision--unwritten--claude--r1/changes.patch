+# Cookies are self-verifying (signed, not looked up), so there is no row to delete on logout.
+# Instead we remember when a member was logged out and reject any cookie issued before that
+# moment: a cookie's issue time is recoverable as its expiry minus EXPIRY_MINUTES, since sign()
+# always sets expiry to issue time + EXPIRY_MINUTES.
+_logged_out_at: dict[int, datetime] = {}
+
+
+def logout(member_id: int) -> None:
+    """Ends member_id's session right away: every cookie already issued for them stops verifying."""
+    _logged_out_at[member_id] = datetime.now(timezone.utc)
+
 
