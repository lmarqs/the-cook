-def items(conn, query: str) -> list[dict]:
+import hashlib
+import json
+import logging
+from typing import Protocol
+
+
+logger = logging.getLogger(__name__)
+CACHE_TTL_SECONDS = 10
+
+
+class ItemCache(Protocol):
+    """The Redis operations used by the catalog; supply a client with timeouts."""
+
+    def get(self, key: str) -> bytes | str | None: ...
+
+    def set(self, key: str, value: str, *, ex: int) -> object: ...
+
+
+def redis_cache(url: str) -> ItemCache:
+    """Create one reusable Redis client per process, with bounded cache waits."""
+    from redis import Redis
+    from redis.backoff import NoBackoff
+    from redis.retry import Retry
+
+    return Redis.from_url(
+        url,
+        socket_connect_timeout=0.05,
+        socket_timeout=0.05,
+        retry=Retry(NoBackoff(), 0),
+    )
+
+
+def _decode_items(value: bytes | str) -> list[dict]:
+    result = json.loads(value)
+    if not isinstance(result, list) or any(
+        not isinstance(row, dict)
+        or set(row) != {"id", "name", "stock"}
+        or not isinstance(row["id"], (int, str))
+        or not isinstance(row["name"], str)
+        or not isinstance(row["stock"], int)
+        for row in result
+    ):
+        raise ValueError("Invalid cached pantry items")
+    return result
+
+
+def items(conn, query: str, *, cache: ItemCache | None = None) -> list[dict]:
     """The pantry items whose name matches the member's search, in name order."""
+    key = "larder:catalog:items:v1:" + hashlib.sha256(query.encode("utf-8")).hexdigest()
+    if cache is not None:
+        try:
+            cached = cache.get(key)
+            if cached is not None:
+                return _decode_items(cached)
+        except Exception:
+            logger.warning("Item cache read failed; querying Postgres", exc_info=True)
+
     rows = conn.execute(
         "select id, name, stock from pantry_items"
         " where to_tsvector('simple', name) @@ plainto_tsquery('simple', %s) order by name",
         (query,),
     ).fetchall()
-    return [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    result = [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    if cache is not None:
+        try:
+            cache.set(key, json.dumps(result), ex=CACHE_TTL_SECONDS)
+        except Exception:
+            logger.warning("Item cache write failed", exc_info=True)
+    return result
