@@ -0,0 +1,115 @@
+import json
+
+import pytest
+
+from larder.catalog import CACHE_TTL_SECONDS, items
+
+
+class FakeConnection:
+    def __init__(self, rows):
+        self.rows = rows
+        self.calls = []
+
+    def execute(self, sql, params):
+        self.calls.append((sql, params))
+        return self
+
+    def fetchall(self):
+        return self.rows
+
+
+class FakeCache:
+    def __init__(self):
+        self.values = {}
+        self.expiries = {}
+
+    def get(self, key):
+        return self.values.get(key)
+
+    def set(self, key, value, *, ex):
+        self.values[key] = value.encode()
+        self.expiries[key] = ex
+
+
+def test_cache_hit_skips_query_and_returns_fresh_objects():
+    conn = FakeConnection([(1, "Beans", 12), (2, "Rice", 4)])
+    cache = FakeCache()
+    expected = [{"id": 1, "name": "Beans", "stock": 12},
+                {"id": 2, "name": "Rice", "stock": 4}]
+
+    first = items(conn, "beans rice", cache=cache)
+    assert first == expected
+    first[0]["stock"] = 0
+    assert items(conn, "beans rice", cache=cache) == expected
+    assert len(conn.calls) == 1
+    assert list(cache.expiries.values()) == [CACHE_TTL_SECONDS]
+
+
+def test_queries_have_distinct_keys_and_remain_parameterized():
+    conn = FakeConnection([])
+    cache = FakeCache()
+    for query in ("beans", "BEANS", "rice' --", "feijão"):
+        items(conn, query, cache=cache)
+        assert conn.calls[-1][1] == (query,)
+        assert query not in conn.calls[-1][0]
+    assert len(cache.values) == 4
+
+
+def test_empty_results_are_cached_and_expiry_refetches_stock():
+    conn = FakeConnection([])
+    cache = FakeCache()
+    assert items(conn, "beans", cache=cache) == []
+    conn.rows = [(1, "Beans", 3)]
+    assert items(conn, "beans", cache=cache) == []
+    cache.values.clear()  # Simulate Redis expiry or eviction.
+    assert items(conn, "beans", cache=cache) == [{"id": 1, "name": "Beans", "stock": 3}]
+    assert len(conn.calls) == 2
+
+
+@pytest.mark.parametrize("payload", [b"broken", b"\xff", b"{}", b"[{}]", b"null",
+                                    b'[{"id": 1, "name": "Beans", "stock": "bad"}]'])
+def test_invalid_cache_entries_are_replaced(payload):
+    conn = FakeConnection([(1, "Beans", 3)])
+    cache = FakeCache()
+    items(conn, "beans", cache=cache)
+    key = next(iter(cache.values))
+    cache.values[key] = payload
+    assert items(conn, "beans", cache=cache) == [{"id": 1, "name": "Beans", "stock": 3}]
+    assert json.loads(cache.values[key])[0]["stock"] == 3
+    assert len(conn.calls) == 2
+
+
+@pytest.mark.parametrize("operation", ["get", "set"])
+def test_cache_failures_fall_back_to_database(operation):
+    class BrokenCache(FakeCache):
+        def get(self, key):
+            if operation == "get":
+                raise ConnectionError("Redis unavailable")
+            return super().get(key)
+
+        def set(self, key, value, *, ex):
+            if operation == "set":
+                raise TimeoutError("Redis timeout")
+            return super().set(key, value, ex=ex)
+
+    conn = FakeConnection([(1, "Beans", 3)])
+    assert items(conn, "beans", cache=BrokenCache()) == [{"id": 1, "name": "Beans", "stock": 3}]
+
+
+def test_without_cache_reads_current_stock_each_time():
+    conn = FakeConnection([(1, "Beans", 3)])
+    items(conn, "beans")
+    conn.rows = [(1, "Beans", 2)]
+    assert items(conn, "beans") == [{"id": 1, "name": "Beans", "stock": 2}]
+    assert len(conn.calls) == 2
+
+
+def test_database_errors_propagate_without_populating_cache():
+    class BrokenConnection:
+        def execute(self, sql, params):
+            raise RuntimeError("Database unavailable")
+
+    cache = FakeCache()
+    with pytest.raises(RuntimeError, match="Database unavailable"):
+        items(BrokenConnection(), "beans", cache=cache)
+    assert cache.values == {}
