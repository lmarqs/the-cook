 Sessions live in Postgres ([keep sessions in the database](../adr/0001-keep-sessions-in-the-database.md)).
 
+## Logout
+
+`logout(member_id)` in `larder/sessions.py` ends a member's current session right away, for a volunteer to use when a
+member's device is lost or stolen. A session cookie carries its own expiry and cannot be deleted, so logout instead
+records the time the member was logged out and `verify` rejects any cookie whose session started at or before that
+time. Logging in again after logout starts a new session that is unaffected.
+
 ## Shaped by
 
 - [Keep sessions in the database](../adr/0001-keep-sessions-in-the-database.md)
diff --git a/larder/sessions.py b/larder/sessions.py
index c4058e5..50f0668 100644
--- a/larder/sessions.py
+++ b/larder/sessions.py
@@ -8,6 +8,10 @@ from datetime import datetime, timedelta, timezone
 EXPIRY_MINUTES = 30
 KEY = os.environ.get("LARDER_SESSION_KEY", "dev-only").encode()
 
+# Cookies are stateless and self-verifying, so there is nothing to delete on logout. Instead we
+# remember when each member last logged out and reject any cookie issued at or before that time.
+_logged_out_at: dict[int, datetime] = {}
+
 
 def expires_at(last_request: datetime) -> datetime:
     """When a session ends if no request renews it."""
@@ -22,12 +26,22 @@ def sign(member_id: int, last_request: datetime) -> str:
 
 
 def verify(cookie: str, now: datetime | None = None) -> int | None:
-    """The member a cookie logs in, or None when it is forged or expired."""
+    """The member a cookie logs in, or None when it is forged, expired or logged out."""
     encoded, _, mac = cookie.rpartition(".")
     body = base64.urlsafe_b64decode(encoded)
     if not hmac.compare_digest(mac, hmac.new(KEY, body, hashlib.sha256).hexdigest()):
         return None
     session = json.loads(body)
-    if datetime.fromisoformat(session["expires"]) < (now or datetime.now(timezone.utc)):
+    expires = datetime.fromisoformat(session["expires"])
+    if expires < (now or datetime.now(timezone.utc)):
+        return None
+    member = session["member"]
+    logged_out_at = _logged_out_at.get(member)
+    if logged_out_at is not None and expires - timedelta(minutes=EXPIRY_MINUTES) <= logged_out_at:
         return None
-    return session["member"]
+    return member
+
+
+def logout(member_id: int) -> None:
+    """Ends member_id's current session right away, for a lost or stolen device."""
+    _logged_out_at[member_id] = datetime.now(timezone.utc)
diff --git a/tests/test_sessions.py b/tests/test_sessions.py
index 56d5389..8f91e17 100644
--- a/tests/test_sessions.py
+++ b/tests/test_sessions.py
@@ -1,9 +1,36 @@
-from datetime import datetime, timedelta
+from datetime import datetime, timedelta, timezone
 
-from larder.sessions import EXPIRY_MINUTES, expires_at
+from larder.sessions import EXPIRY_MINUTES, expires_at, logout, sign, verify
 
 
 def test_a_session_ends_after_the_expiry_without_a_request():
     start = datetime(2026, 1, 1, 12, 0)
 
     assert expires_at(start) == start + timedelta(minutes=EXPIRY_MINUTES)
+
+
+def test_logout_ends_an_existing_session_right_away():
+    member_id = 1
+    cookie = sign(member_id, datetime.now(timezone.utc))
+
+    logout(member_id)
+
+    assert verify(cookie) is None
+
+
+def test_logout_does_not_affect_another_member():
+    member_id, other_member_id = 2, 3
+    cookie = sign(other_member_id, datetime.now(timezone.utc))
+
+    logout(member_id)
+
+    assert verify(cookie) == other_member_id
+
+
+def test_logging_in_again_after_logout_works():
+    member_id = 4
+
+    logout(member_id)
+    cookie = sign(member_id, datetime.now(timezone.utc))
+
+    assert verify(cookie) == member_id
