diff --git a/migrations/001_member_session_versions.sql b/migrations/001_member_session_versions.sql
new file mode 100644
index 0000000..096d659
--- /dev/null
+++ b/migrations/001_member_session_versions.sql
@@ -0,0 +1,6 @@
+-- Run once against the shared Postgres database before deploying session revocation.
+-- One row per revoked member, independent of the number of logins or logouts.
+CREATE TABLE member_session_versions (
+    member_id BIGINT PRIMARY KEY,
+    version BIGINT NOT NULL CHECK (version > 0)
+);
