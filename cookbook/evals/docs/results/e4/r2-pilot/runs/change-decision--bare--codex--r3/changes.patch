new file mode 100644
index 0000000..b45681b
--- /dev/null
+++ b/migrations/0001_member_session_versions.sql
@@ -0,0 +1,6 @@
+-- Apply to the shared Postgres database before deploying session revocation.
+-- One row per member who has been logged out; never delete or reset versions.
+CREATE TABLE member_session_versions (
+    member_id BIGINT PRIMARY KEY,
+    version BIGINT NOT NULL CHECK (version > 0)
+);
