 KEY = os.environ.get("LARDER_SESSION_KEY", "dev-only").encode()
 
 
+def _connect():
+    """Connect to the shared database; never fall back to process-local state."""
+    import psycopg
+
+    return psycopg.connect(os.environ["DATABASE_URL"])
+
+
+def _version(member_id: int) -> int:
+    with _connect() as connection:
+        row = connection.execute(
+            "SELECT version FROM member_session_versions WHERE member_id = %s", (member_id,)
+        ).fetchone()
+    return row[0] if row else 0
+
+
+def logout(member_id: int) -> None:
+    """Invalidate all of a member's existing cookies on every server, durably."""
+    with _connect() as connection:
+        connection.execute(
+            """INSERT INTO member_session_versions (member_id, version) VALUES (%s, 1)
+            ON CONFLICT (member_id) DO UPDATE
+            SET version = member_session_versions.version + 1""",
+            (member_id,),
+        )
+
+
 def expires_at(last_request: datetime) -> datetime:
     """When a session ends if no request renews it."""
     return last_request + timedelta(minutes=EXPIRY_MINUTES)
