+def test_logout_revokes_cookies_from_before_versioning_was_deployed(session_database):
+    now = datetime.now(timezone.utc)
+    body = json.dumps({"member": 1, "expires": sessions.expires_at(now).isoformat()}).encode()
+    cookie = base64.urlsafe_b64encode(body).decode() + "." + hmac.new(
