+def test_logout_revokes_all_existing_cookies_for_only_that_member(session_database):
+    now = datetime.now(timezone.utc)
+    cookies = [sessions.sign(1, now), sessions.sign(1, now + timedelta(seconds=1))]
+    other_cookie = sessions.sign(2, now)
+    assert all(sessions.verify(cookie, now) == 1 for cookie in cookies)
+
+    assert sessions.logout(1) is None
+
+    assert all(sessions.verify(cookie, now) is None for cookie in cookies)
+    assert sessions.verify(other_cookie, now) == 2
+    assert sessions.verify(sessions.sign(1, now), now) == 1
+
+
+def test_repeated_logout_revokes_new_login_without_growing_session_history(session_database):
+    now = datetime.now(timezone.utc)
+    sessions.logout(1)
+    cookie = sessions.sign(1, now)
+    sessions.logout(1)
+
+    assert sessions.verify(cookie, now) is None
+    with sqlite3.connect(session_database) as connection:
+        assert connection.execute("SELECT * FROM member_session_versions").fetchall() == [(1, 2)]
+
+
+def test_another_server_and_a_restarted_server_observe_logout(session_database, monkeypatch):
+    def load_server():
+        spec = importlib.util.spec_from_file_location("another_server_sessions", sessions.__file__)
+        server = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(server)
+        monkeypatch.setattr(server, "_connect", sessions._connect)
+        return server
+
+    now = datetime.now(timezone.utc)
+    cookie = sessions.sign(1, now)
+    other_server = load_server()
+    assert other_server.verify(cookie, now) == 1
+
+    other_server.logout(1)
+
+    assert sessions.verify(cookie, now) is None
+    assert load_server().verify(cookie, now) is None
+
+
+def test_concurrent_logouts_increment_without_losing_updates(session_database):
+    with ThreadPoolExecutor(max_workers=4) as executor:
