@@ -0,0 +1,90 @@
+import json
+from unittest.mock import Mock
+
+import pytest
+
+from larder import catalog
+
+
+@pytest.fixture
+def cache(monkeypatch):
+    client = Mock()
+    client.get.return_value = None
+    monkeypatch.setenv("REDIS_URL", "redis://localhost:6379/0")
+    monkeypatch.setattr(catalog, "_redis_client", Mock(return_value=client))
+    return client
+
+
+@pytest.fixture
+def conn():
+    connection = Mock()
+    connection.execute.return_value.fetchall.return_value = [(1, "Rice", 10)]
+    return connection
+
+
+def test_unconfigured_cache_reads_database(monkeypatch, conn):
+    monkeypatch.delenv("REDIS_URL", raising=False)
+    factory = Mock(side_effect=AssertionError("Redis must not be used"))
+    monkeypatch.setattr(catalog, "_redis_client", factory)
+
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 10}]
+    factory.assert_not_called()
+    assert conn.execute.call_args.args[1] == ("rice",)
+
+
+def test_miss_populates_expiring_cache_and_hit_skips_database(cache, conn):
+    expected = [{"id": 1, "name": "Rice", "stock": 10}]
+    assert catalog.items(conn, "rice") == expected
+    key, ttl, value = cache.setex.call_args.args
+    assert ttl == 15
+    assert json.loads(value) == expected
+    cache.get.assert_called_once_with(key)
+
+    cache.get.return_value = value.encode()
+    conn.reset_mock()
+    assert catalog.items(conn, "rice") == expected
+    conn.execute.assert_not_called()
+
+
+def test_queries_have_distinct_keys(cache, conn):
+    catalog.items(conn, "rice")
+    catalog.items(conn, "beans")
+    assert cache.get.call_args_list[0] != cache.get.call_args_list[1]
+
+
+def test_empty_results_are_cached(cache, conn):
+    conn.execute.return_value.fetchall.return_value = []
+    assert catalog.items(conn, "missing") == []
+    cache.get.return_value = b"[]"
+    conn.reset_mock()
+    assert catalog.items(conn, "missing") == []
+    conn.execute.assert_not_called()
+
+
+@pytest.mark.parametrize("value", [b"broken", b"null", b"{}", b"[{}]", b"\xff"])
+def test_invalid_cache_falls_back_to_database(cache, conn, value):
+    cache.get.return_value = value
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 10}]
+
+
+def test_redis_read_failure_falls_back_without_attempting_write(cache, conn):
+    cache.get.side_effect = TimeoutError
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 10}]
+    cache.setex.assert_not_called()
+
+
+def test_redis_write_failure_returns_database_result(cache, conn):
+    cache.setex.side_effect = ConnectionError
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 10}]
+
+
+def test_client_setup_failure_falls_back(cache, conn):
+    catalog._redis_client.side_effect = ValueError("bad URL")
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 10}]
+
+
+def test_database_errors_propagate_and_are_not_cached(cache, conn):
+    conn.execute.side_effect = RuntimeError("database unavailable")
+    with pytest.raises(RuntimeError, match="database unavailable"):
+        catalog.items(conn, "rice")
+    cache.setex.assert_not_called()
