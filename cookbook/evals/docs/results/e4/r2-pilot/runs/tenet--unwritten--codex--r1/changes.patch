+import hashlib
+import json
+import logging
+import os
+from functools import lru_cache
+
+
+CACHE_TTL_SECONDS = 15
+logger = logging.getLogger(__name__)
+
+
+@lru_cache(maxsize=1)
+def _redis_client(url):
+    # Keep unconfigured installations independent of Redis.
+    from redis import Redis
+    from redis.backoff import NoBackoff
+    from redis.retry import Retry
+
+    return Redis.from_url(
+        url,
+        socket_connect_timeout=0.1,
+        socket_timeout=0.1,
+        retry=Retry(NoBackoff(), 0),
+    )
+
+
 def items(conn, query: str) -> list[dict]:
-    """The pantry items whose name matches the member's search, in name order."""
+    """Matching pantry items in name order; cached briefly when REDIS_URL is set."""
+    cache = None
+    key = "larder:catalog:items:v1:" + hashlib.sha256(query.encode()).hexdigest()
+    url = os.environ.get("REDIS_URL")
+    if url:
+        try:
+            cache = _redis_client(url)
+            value = cache.get(key)
+            if value is not None:
+                result = json.loads(value)
+                if not isinstance(result, list) or any(
+                    not isinstance(item, dict) or set(item) != {"id", "name", "stock"}
+                    for item in result
+                ):
+                    raise ValueError("Invalid cached catalog result")
+                return result
+        except Exception:
+            # Cache failures must not prevent a fresh database read. Avoid logging
+            # the exception, which may contain credentials from the Redis URL.
+            logger.warning("Catalog cache read failed; using Postgres")
+            cache = None
+
     rows = conn.execute(
         "select id, name, stock from pantry_items"
         " where to_tsvector('simple', name) @@ plainto_tsquery('simple', %s) order by name",
         (query,),
     ).fetchall()
-    return [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    result = [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    if cache is not None:
+        try:
+            cache.setex(key, CACHE_TTL_SECONDS, json.dumps(result))
+        except Exception:
+            logger.warning("Catalog cache write failed; returning Postgres result")
+    return result
