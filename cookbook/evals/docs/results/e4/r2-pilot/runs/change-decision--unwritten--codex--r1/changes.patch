+def _generation(member_id: int) -> int:
+    with _connect() as connection:
+        row = connection.execute(
+            "SELECT generation FROM member_sessions WHERE member_id = %s", (member_id,)
+        ).fetchone()
+    return row[0] if row else 0
+
