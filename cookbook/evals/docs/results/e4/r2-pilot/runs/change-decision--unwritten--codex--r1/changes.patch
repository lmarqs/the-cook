+def logout(member_id: int) -> None:
+    """Revoke all cookies issued so far for this member, across web servers."""
+    with _connect() as connection:
+        connection.execute(
+            """INSERT INTO member_sessions (member_id, generation) VALUES (%s, 1)
+               ON CONFLICT (member_id) DO UPDATE
+               SET generation = member_sessions.generation + 1""",
+            (member_id,),
+        )
+
