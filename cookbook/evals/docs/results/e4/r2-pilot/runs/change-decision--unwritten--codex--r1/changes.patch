+def test_database_failure_cannot_authenticate_or_report_successful_logout(session_database, monkeypatch):
+    now = datetime.now(timezone.utc)
+    cookie = sessions.sign(1, now)
+
+    def unavailable():
+        raise ConnectionError("database unavailable")
+
+    monkeypatch.setattr(sessions, "_connect", unavailable)
