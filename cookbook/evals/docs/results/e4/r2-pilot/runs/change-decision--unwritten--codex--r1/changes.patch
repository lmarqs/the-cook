+@pytest.fixture
+def session_database(tmp_path, monkeypatch):
+    """Run the storage queries against a persistent DB with fresh connections."""
+    database = tmp_path / "sessions.db"
+    with sqlite3.connect(database) as connection:
+        schema = Path(__file__).resolve().parents[1] / "larder/schema.sql"
+        connection.executescript(schema.read_text())
+
+    class Connection:
+        def __init__(self, connection):
+            self.connection = connection
+
+        def execute(self, query, parameters):
+            return self.connection.execute(query.replace("%s", "?"), parameters)
+
+    @contextmanager
+    def connect():
+        connection = sqlite3.connect(database)
+        try:
+            with connection:
+                yield Connection(connection)
+        finally:
+            connection.close()
+
+    monkeypatch.setattr(sessions, "_connect", connect)
+    return connect
+
+
+def signed_payload(payload):
+    body = json.dumps(payload).encode()
+    mac = hmac.new(sessions.KEY, body, hashlib.sha256).hexdigest()
+    return base64.urlsafe_b64encode(body).decode() + "." + mac
+
+
+def test_logout_revokes_all_member_cookies_and_allows_new_login(session_database):
+    now = datetime.now(timezone.utc)
+    first = sessions.sign(1, now)
+    second = sessions.sign(1, now + timedelta(seconds=1))
+    other_member = sessions.sign(2, now)
+    assert sessions.verify(first, now) == 1
+
+    sessions.logout(1)
+
+    assert sessions.verify(first, now) is None
+    assert sessions.verify(second, now) is None
+    assert sessions.verify(other_member, now) == 2
+    new_cookie = sessions.sign(1, now)
+    assert sessions.verify(new_cookie, now) == 1
+    sessions.logout(1)
+    assert sessions.verify(new_cookie, now) is None
+    assert sessions.verify(first, now) is None
+
+
+def test_logout_revokes_legacy_cookie_without_logging_out_other_members(session_database):
+    now = datetime.now(timezone.utc)
+    cookie = signed_payload({"member": 1, "expires": expires_at(now).isoformat()})
+    assert sessions.verify(cookie, now) == 1
+    sessions.logout(2)
+    assert sessions.verify(cookie, now) == 1
+    sessions.logout(1)
+    assert sessions.verify(cookie, now) is None
+
+
+def test_logout_survives_module_reload(session_database, monkeypatch):
+    now = datetime.now(timezone.utc)
+    cookie = sessions.sign(1, now)
+    sessions.logout(1)
+    importlib.reload(sessions)
+    monkeypatch.setattr(sessions, "_connect", session_database)
+    assert sessions.verify(cookie, now) is None
+    assert sessions.verify(sessions.sign(1, now), now) == 1
+
+
+def test_logout_before_login_and_repeated_logout_are_safe(session_database):
+    sessions.logout(99)
+    sessions.logout(99)
+    now = datetime.now(timezone.utc)
+    assert sessions.verify(sessions.sign(99, now), now) == 99
+
+
+def test_cookie_expires_at_deadline_and_cannot_be_tampered_with(session_database):
+    now = datetime.now(timezone.utc)
+    cookie = sessions.sign(1, now)
+    assert sessions.verify(cookie, expires_at(now) - timedelta(microseconds=1)) == 1
+    assert sessions.verify(cookie, expires_at(now)) is None
+    assert sessions.verify(cookie + "0", now) is None
+
+
+@pytest.mark.parametrize("cookie", ["", "%%%.$", "a.mac", "é.mac", signed_payload([]),
+                                       signed_payload({}), signed_payload({"member": True})])
+def test_malformed_cookies_are_rejected(cookie):
+    assert sessions.verify(cookie) is None
+
