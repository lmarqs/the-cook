+import time
+
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +21,38 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+class TimingOutGateway(FakeGateway):
+    def __init__(self, failures):
+        super().__init__()
+        self.failures = failures
+        self.timeout = GatewayTimeout("gateway did not answer")
+
+    def capture(self, order_id, amount_cents, idempotency_key):
+        charge_id = super().capture(order_id, amount_cents, idempotency_key)
+        if len(self.calls) <= self.failures:
+            raise self.timeout
+        return charge_id
+
+
+@pytest.mark.parametrize("failures", [1, 2, 3])
+def test_capture_retries_immediately_with_the_same_key(monkeypatch, failures):
+    def unexpected_sleep(seconds):
+        pytest.fail("capture must not pause between attempts")
+
+    monkeypatch.setattr(time, "sleep", unexpected_sleep)
+    gateway = TimingOutGateway(failures)
+
+    if failures == 3:
+        with pytest.raises(GatewayTimeout) as error:
+            capture(Order("o1", 1250), gateway)
+        assert error.value is gateway.timeout
+    else:
+        assert capture(Order("o1", 1250), gateway) == "ch_1"
+
+    assert len(gateway.calls) == min(failures + 1, 3)
+    assert all(call[:2] == ("o1", 1250) for call in gateway.calls)
+    keys = {call[2] for call in gateway.calls}
+    assert len(keys) == 1
+    assert next(iter(keys))
