+@pytest.fixture
+def store(tmp_path, monkeypatch):
+    """Exercise SQL and commits through independent connections to a shared file."""
+    database = tmp_path / "sessions.db"
+    with sqlite3.connect(database) as connection:
+        connection.executescript(Path(sessions.__file__).with_suffix(".sql").read_text())
+
+    class Connection:
+        def __init__(self, connection):
+            self.connection = connection
+
+        def execute(self, query, params):
+            params = tuple(p.isoformat() if isinstance(p, datetime) else p for p in params)
+            return self.connection.execute(query.replace("%s", "?"), params)
+
+    @contextmanager
+    def connect():
+        connection = sqlite3.connect(database)
+        try:
+            with connection:
+                yield Connection(connection)
+        finally:
+            connection.close()
+
+    monkeypatch.setattr(sessions, "_connect", connect)
+    return connect
+
+
+def test_logout_revokes_all_member_cookies_on_other_servers(store, monkeypatch):
+    now = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    stolen = sessions.sign(1, now)
+    another_device = sessions.sign(1, now)
+    other_member = sessions.sign(2, now)
+
+    spec = importlib.util.spec_from_file_location("another_server", sessions.__file__)
+    server = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(server)
+    monkeypatch.setattr(server, "_connect", store)
+    assert server.verify(stolen, now) == 1
+
+    sessions.logout(1)
+    sessions.logout(1)
+    sessions.logout(999)
+
+    assert server.verify(stolen, now) is None
+    assert server.verify(another_device, now) is None
+    assert server.verify(other_member, now) == 2
+    fresh = server.sign(1, now)
+    assert sessions.verify(fresh, now) == 1
+    assert sessions.verify(stolen, now) is None
+
+
+def test_expiry_and_forgery(store):
+    now = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    cookie = sessions.sign(1, now)
+    assert sessions.verify(cookie, now + timedelta(minutes=29)) == 1
+    assert sessions.verify(cookie, expires_at(now)) is None
+    assert sessions.verify(cookie, expires_at(now) + timedelta(seconds=1)) is None
+    assert sessions.verify(cookie[:-1] + ("0" if cookie[-1] != "0" else "1"), now) is None
+
+
+@pytest.mark.parametrize("cookie", ["", "%%%.", "not-a-cookie", "é.mac"])
+def test_malformed_cookies_are_rejected(cookie):
+    assert sessions.verify(cookie) is None
+
+
+def test_legacy_cookies_cannot_bypass_revocation():
+    now = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    body = json.dumps({"member": 1, "expires": expires_at(now).isoformat()}).encode()
+    mac = hmac.new(sessions.KEY, body, hashlib.sha256).hexdigest()
+    cookie = base64.urlsafe_b64encode(body).decode() + "." + mac
+    assert sessions.verify(cookie, now) is None
+
+
+def test_database_failure_is_not_reported_as_success(store, monkeypatch):
+    def unavailable():
+        raise ConnectionError("database unavailable")
+
+    now = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    cookie = sessions.sign(1, now)
+    monkeypatch.setattr(sessions, "_connect", unavailable)
+    with pytest.raises(ConnectionError):
+        sessions.logout(1)
+    with pytest.raises(ConnectionError):
+        sessions.sign(1, now)
+    with pytest.raises(ConnectionError):
+        sessions.verify(cookie, now)
