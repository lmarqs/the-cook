+++ b/tests/test_reminders.py
@@ -0,0 +1,15 @@
+from unittest.mock import Mock
+
+from larder.reminders import remind
+
+
+def test_pickup_reminder_is_sent_by_email():
+    send_sms = Mock()
+    send_email = Mock()
+
+    remind("+351912345678", "member@example.com", "tomorrow at 17:00", send_sms, send_email)
+
+    send_email.assert_called_once_with(
+        "member@example.com", "Your pantry order is ready for pickup tomorrow at 17:00."
+    )
+    send_sms.assert_not_called()
