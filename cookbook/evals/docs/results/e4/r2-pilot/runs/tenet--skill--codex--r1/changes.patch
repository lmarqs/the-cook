diff --git a/sql/catalog-search-index.sql b/sql/catalog-search-index.sql
new file mode 100644
index 0000000..4d00238
--- /dev/null
+++ b/sql/catalog-search-index.sql
@@ -0,0 +1,6 @@
+-- Run with psql in autocommit mode, outside a migration transaction.
+-- Match the expression in larder/catalog.py exactly.
+CREATE INDEX CONCURRENTLY pantry_items_name_search_idx
+    ON pantry_items USING gin (to_tsvector('simple', name));
+
+ANALYZE pantry_items;
