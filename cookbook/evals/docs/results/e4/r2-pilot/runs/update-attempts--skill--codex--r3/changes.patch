+import time
+
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
@@ -16,3 +21,32 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+@pytest.mark.parametrize("timeouts", [2, 3])
+def test_capture_retries_immediately_with_the_same_key(monkeypatch, timeouts):
+    def unexpected_sleep(seconds):
+        pytest.fail("capture must not pause between attempts")
+
+    monkeypatch.setattr(time, "sleep", unexpected_sleep)
+    calls = []
+    timeout = GatewayTimeout("gateway did not answer")
+
+    class TimeoutGateway:
+        def capture(self, order_id, amount_cents, idempotency_key):
+            calls.append((order_id, amount_cents, idempotency_key))
+            if len(calls) <= timeouts:
+                raise timeout
+            return "ch_1"
+
+    if timeouts == 3:
+        with pytest.raises(GatewayTimeout) as raised:
+            capture(Order("o1", 1250), TimeoutGateway())
+        assert raised.value is timeout
+    else:
+        assert capture(Order("o1", 1250), TimeoutGateway()) == "ch_1"
+
+    assert len(calls) == 3
+    assert all(call[:2] == ("o1", 1250) for call in calls)
+    assert calls[0][2]
+    assert len({call[2] for call in calls}) == 1
