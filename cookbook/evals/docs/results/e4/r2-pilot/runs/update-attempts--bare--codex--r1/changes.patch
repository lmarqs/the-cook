+@pytest.mark.parametrize("timeouts", [1, 2])
+def test_capture_retries_timeouts_and_stops_on_success(timeouts):
+    gateway = FakeGateway([GatewayTimeout() for _ in range(timeouts)] + ["ch_1"])
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+    assert len(gateway.calls) == timeouts + 1
+    assert all(call[:2] == ("o1", 1250) for call in gateway.calls)
+    assert gateway.calls[0][2]
+    assert len({call[2] for call in gateway.calls}) == 1
+
+
+def test_capture_raises_the_third_timeout_without_a_fourth_attempt():
+    last_timeout = GatewayTimeout("third attempt")
+    gateway = FakeGateway([GatewayTimeout(), GatewayTimeout(), last_timeout, "ch_1"])
+
+    with pytest.raises(GatewayTimeout) as exc_info:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc_info.value is last_timeout
+    assert len(gateway.calls) == 3
+    assert len({call[2] for call in gateway.calls}) == 1
+
+
+def test_capture_does_not_retry_other_errors():
+    error = ValueError("invalid capture")
+    gateway = FakeGateway([error, "ch_1"])
+
+    with pytest.raises(ValueError) as exc_info:
+        capture(Order("o1", 1250), gateway)
+
+    assert exc_info.value is error
+    assert len(gateway.calls) == 1
+
+
+def test_separate_captures_use_different_idempotency_keys():
+    gateway = FakeGateway(["ch_1", "ch_2"])
+    order = Order("o1", 1250)
+
+    capture(order, gateway)
+    capture(order, gateway)
+
+    assert gateway.calls[0][2] != gateway.calls[1][2]
