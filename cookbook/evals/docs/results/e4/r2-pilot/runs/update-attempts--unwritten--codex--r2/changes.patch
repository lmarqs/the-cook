+import time
+
+import pytest
+
 from larder.capture import capture
+from larder.gateway import GatewayTimeout
 from larder.orders import Order
 
 
 class FakeGateway:
-    def __init__(self):
+    def __init__(self, timeouts=0):
         self.calls = []
+        self.timeouts = timeouts
 
     def capture(self, order_id, amount_cents, idempotency_key):
         self.calls.append((order_id, amount_cents, idempotency_key))
+        if len(self.calls) <= self.timeouts:
+            raise GatewayTimeout
         return "ch_1"
 
 
@@ -16,3 +24,31 @@ def test_capture_returns_the_charge_id():
 
     assert capture(Order("o1", 1250), gateway) == "ch_1"
     assert gateway.calls[0][:2] == ("o1", 1250)
+
+
+@pytest.fixture
+def no_sleep(monkeypatch):
+    def unexpected_sleep(seconds):
+        pytest.fail("capture must retry without pausing")
+
+    monkeypatch.setattr(time, "sleep", unexpected_sleep)
+
+
+@pytest.mark.parametrize("timeouts", [1, 2])
+def test_capture_retries_timeouts_with_the_same_key(timeouts, no_sleep):
+    gateway = FakeGateway(timeouts=timeouts)
+
+    assert capture(Order("o1", 1250), gateway) == "ch_1"
+    assert len(gateway.calls) == timeouts + 1
+    assert gateway.calls == [gateway.calls[0]] * (timeouts + 1)
+    assert gateway.calls[0][2]
+
+
+def test_capture_raises_after_three_timeouts(no_sleep):
+    gateway = FakeGateway(timeouts=3)
+
+    with pytest.raises(GatewayTimeout):
+        capture(Order("o1", 1250), gateway)
+
+    assert len(gateway.calls) == 3
+    assert gateway.calls == [gateway.calls[0]] * 3
