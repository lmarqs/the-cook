     if not hmac.compare_digest(mac, hmac.new(KEY, body, hashlib.sha256).hexdigest()):
         return None
-    session = json.loads(body)
-    if datetime.fromisoformat(session["expires"]) < (now or datetime.now(timezone.utc)):
+    try:
+        session = json.loads(body)
+        member_id = session["member"]
+        version = session.get("version", 0)
+        if type(member_id) is not int or type(version) is not int or version < 0:
+            return None
+        if datetime.fromisoformat(session["expires"]) <= (now or datetime.now(timezone.utc)):
+            return None
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return None
+    if version != _versions.get(member_id):
         return None
-    return session["member"]
