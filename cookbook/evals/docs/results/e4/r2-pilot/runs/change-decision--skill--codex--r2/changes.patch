+"""Durable member revocation counters shared by every web server."""
+
+import os
+
+
+class PostgresSessionVersions:
+    def _connect(self):
+        import psycopg
+
+        return psycopg.connect(os.environ["DATABASE_URL"])
+
+    def get(self, member_id: int) -> int:
+        with self._connect() as connection:
+            row = connection.execute(
+                "SELECT version FROM member_session_versions WHERE member_id = %s",
+                (member_id,),
+            ).fetchone()
+        return row[0] if row else 0
+
+    def revoke(self, member_id: int) -> None:
+        with self._connect() as connection:
+            connection.execute(
+                """INSERT INTO member_session_versions (member_id, version) VALUES (%s, 1)
+                   ON CONFLICT (member_id) DO UPDATE
+                   SET version = member_session_versions.version + 1""",
+                (member_id,),
+            )
