+
+def _sign(member_id: int, last_request: datetime, version: int) -> str:
+    body = json.dumps({
+        "member": member_id,
+        "expires": expires_at(last_request).isoformat(),
+        "version": version,
+    }).encode()
     mac = hmac.new(KEY, body, hashlib.sha256).hexdigest()
     return base64.urlsafe_b64encode(body).decode() + "." + mac
 
 
 def verify(cookie: str, now: datetime | None = None) -> int | None:
-    """The member a cookie logs in, or None when it is forged or expired."""
+    """The member a cookie logs in, or None when invalid, expired or revoked."""
+    session = _verify(cookie, now)
+    return session["member"] if session else None
+
+
+def logout(member_id: int) -> None:
+    """Revoke all existing cookies for this member on every server, durably."""
+    _versions.revoke(member_id)
+
+
+def renew(cookie: str, last_request: datetime) -> str | None:
+    """Renew a valid cookie without letting an in-flight request undo logout."""
+    session = _verify(cookie, last_request)
+    if session is None:
+        return None
+    return _sign(session["member"], last_request, session.get("version", 0))
+
+
