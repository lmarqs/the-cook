+from functools import lru_cache
+from hashlib import sha256
+import json
+import logging
+import os
+
+
+logger = logging.getLogger(__name__)
+CACHE_TTL_SECONDS = 15
+
+
+@lru_cache(maxsize=1)
+def _redis_client(url):
+    from redis import Redis
+    from redis.backoff import NoBackoff
+    from redis.retry import Retry
+
+    return Redis.from_url(
+        url,
+        socket_connect_timeout=0.1,
+        socket_timeout=0.1,
+        retry=Retry(NoBackoff(), 0),
+    )
+
+
+def _cached_items(value):
+    result = json.loads(value)
+    if not isinstance(result, list) or any(
+        not isinstance(item, dict) or set(item) != {"id", "name", "stock"}
+        for item in result
+    ):
+        raise ValueError("Invalid catalog cache entry")
+    return result
+
+
 def items(conn, query: str) -> list[dict]:
-    """The pantry items whose name matches the member's search, in name order."""
+    """Matching pantry items in name order; cached stock can be 15 seconds old."""
+    cache = None
+    url = os.environ.get("REDIS_URL")
+    key = "larder:catalog:items:v1:" + sha256(query.encode("utf-8")).hexdigest()
+    if url:
+        # Cache failures must not prevent a member from browsing the pantry.
+        try:
+            cache = _redis_client(url)
+            value = cache.get(key)
+        except Exception:
+            logger.warning("Catalog cache read failed; querying Postgres", exc_info=True)
+            cache = None
+        else:
+            if value is not None:
+                try:
+                    return _cached_items(value)
+                except (ValueError, TypeError, UnicodeError):
+                    logger.warning("Invalid catalog cache entry; querying Postgres")
+
     rows = conn.execute(
         "select id, name, stock from pantry_items"
         " where to_tsvector('simple', name) @@ plainto_tsquery('simple', %s) order by name",
         (query,),
     ).fetchall()
-    return [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    result = [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    if cache is not None:
+        try:
+            cache.set(key, json.dumps(result), ex=CACHE_TTL_SECONDS)
+        except Exception:
+            logger.warning("Catalog cache write failed", exc_info=True)
+    return result
