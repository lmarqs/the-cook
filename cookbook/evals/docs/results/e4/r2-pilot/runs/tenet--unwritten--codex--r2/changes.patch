+import json
+from unittest.mock import Mock
+
+import pytest
+
+from larder import catalog
+
+
+@pytest.fixture
+def conn():
+    connection = Mock()
+    connection.execute.return_value.fetchall.return_value = [(1, "Rice", 8)]
+    return connection
+
+
+@pytest.fixture
+def cache(monkeypatch):
+    monkeypatch.setenv("REDIS_URL", "redis://localhost:6379/0")
+    client = Mock()
+    client.get.return_value = None
+    monkeypatch.setattr(catalog, "_redis_client", Mock(return_value=client))
+    return client
+
+
+def test_disabled_cache_keeps_parameterized_database_query(conn, monkeypatch):
+    monkeypatch.delenv("REDIS_URL", raising=False)
+    factory = Mock()
+    monkeypatch.setattr(catalog, "_redis_client", factory)
+
+    assert catalog.items(conn, "rice' OR 1=1") == [{"id": 1, "name": "Rice", "stock": 8}]
+    assert conn.execute.call_args.args[1] == ("rice' OR 1=1",)
+    factory.assert_not_called()
+
+
+def test_miss_populates_cache_and_hit_skips_database(conn, cache):
+    first = catalog.items(conn, "rice")
+    key, payload = cache.set.call_args.args
+    assert json.loads(payload) == first
+    assert cache.set.call_args.kwargs == {"ex": 15}
+    cache.get.return_value = payload.encode()
+
+    assert catalog.items(conn, "rice") == first
+    assert conn.execute.call_count == 1
+    assert cache.get.call_args.args == (key,)
+
+
+def test_different_queries_have_distinct_bounded_keys(conn, cache):
+    catalog.items(conn, "rice")
+    first_key = cache.get.call_args.args[0]
+    catalog.items(conn, "rice " * 1000)
+    second_key = cache.get.call_args.args[0]
+    assert first_key != second_key
+    assert len(first_key) == len(second_key)
+
+
+def test_empty_results_are_a_cache_hit(conn, cache):
+    conn.execute.return_value.fetchall.return_value = []
+    assert catalog.items(conn, "missing") == []
+    cache.get.return_value = cache.set.call_args.args[1]
+    assert catalog.items(conn, "missing") == []
+    assert conn.execute.call_count == 1
+
+
+@pytest.mark.parametrize("payload", [b"bad json", b"\xff", "null", "{}", '[{"name": "Rice"}]'])
+def test_invalid_cache_is_replaced_from_database(conn, cache, payload):
+    cache.get.return_value = payload
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice", "stock": 8}]
+    cache.set.assert_called_once()
+
+
+def test_read_failure_falls_back_without_another_cache_attempt(conn, cache):
+    cache.get.side_effect = OSError("Redis unavailable")
+    assert catalog.items(conn, "rice")[0]["stock"] == 8
+    cache.set.assert_not_called()
+
+
+def test_initialization_failure_falls_back(conn, cache):
+    catalog._redis_client.side_effect = ValueError("Invalid URL")
+    assert catalog.items(conn, "rice")[0]["stock"] == 8
+
+
+def test_write_failure_returns_database_result(conn, cache):
+    cache.set.side_effect = OSError("Redis out of memory")
+    assert catalog.items(conn, "rice")[0]["stock"] == 8
+
+
+def test_database_failure_is_not_hidden(conn, cache):
+    conn.execute.side_effect = RuntimeError("Postgres unavailable")
+    with pytest.raises(RuntimeError, match="Postgres unavailable"):
+        catalog.items(conn, "rice")
+    cache.set.assert_not_called()
