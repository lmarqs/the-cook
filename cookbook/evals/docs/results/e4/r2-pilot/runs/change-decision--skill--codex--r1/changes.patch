diff --git a/migrations/001_member_session_generations.sql b/migrations/001_member_session_generations.sql
new file mode 100644
index 0000000..2235c30
--- /dev/null
+++ b/migrations/001_member_session_generations.sql
@@ -0,0 +1,6 @@
+-- One row per member who has been logged out, never one row per session.
+-- Keep rows: deleting one could make an old generation-zero cookie valid again.
+CREATE TABLE member_session_generations (
+    member_id BIGINT PRIMARY KEY,
+    generation BIGINT NOT NULL CHECK (generation > 0)
+);
