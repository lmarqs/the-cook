diff --git a/migrations/001_pantry_items_name_search.sql b/migrations/001_pantry_items_name_search.sql
new file mode 100644
index 0000000..e8b308c
--- /dev/null
+++ b/migrations/001_pantry_items_name_search.sql
@@ -0,0 +1,6 @@
+-- Run with psql in autocommit mode; CONCURRENTLY cannot run in a transaction.
+-- See docs/runbooks/pantry-search.md before applying to an existing database.
+CREATE INDEX CONCURRENTLY pantry_items_name_search_idx
+    ON pantry_items USING gin (to_tsvector('simple', name));
+
+ANALYZE pantry_items;
