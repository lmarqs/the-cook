+@pytest.fixture
+def database(tmp_path, monkeypatch):
+    """Exercise stored sessions over separate connections to a shared test database."""
+    path = tmp_path / "sessions.db"
+    with sqlite3.connect(path) as connection:
+        connection.executescript(Path(sessions.__file__).with_suffix(".sql").read_text())
+
+    class Connection:
+        def __enter__(self):
+            self.connection = sqlite3.connect(path)
+            return self
+
+        def execute(self, query, parameters):
+            parameters = tuple(p.isoformat() if isinstance(p, datetime) else p for p in parameters)
+            return self.connection.execute(query.replace("%s", "?"), parameters)
+
+        def __exit__(self, *exc):
+            try:
+                return self.connection.__exit__(*exc)
+            finally:
+                self.connection.close()
+
+    monkeypatch.setattr(sessions, "_connect", Connection)
+    return Connection
+
+
+START = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def test_logout_revokes_all_member_cookies_but_preserves_other_members(database):
+    stolen = sessions.sign(1, START)
+    second_device = sessions.sign(1, START)
+    other_member = sessions.sign(2, START)
+    assert stolen != second_device
+    assert sessions.verify(stolen, START) == 1
+    assert sessions.verify(second_device, START) == 1
+    assert sessions.verify(other_member, START) == 2
+
+    assert sessions.logout(1) is None
+
+    assert sessions.verify(stolen, START) is None
+    assert sessions.verify(second_device, START) is None
+    assert sessions.verify(other_member, START) == 2
+
+
+def test_logout_is_repeatable_and_member_can_log_in_again(database):
+    old_cookie = sessions.sign(1, START)
+    sessions.logout(999)
+    assert sessions.verify(old_cookie, START) == 1
+    sessions.logout(1)
+    sessions.logout(1)
+
+    new_cookie = sessions.sign(1, START)
+    assert sessions.verify(new_cookie, START) == 1
+    assert sessions.verify(old_cookie, START) is None
+
+
+def test_revocation_survives_reloading_the_module(database, monkeypatch):
+    cookie = sessions.sign(1, START)
+    importlib.reload(sessions)
+    monkeypatch.setattr(sessions, "_connect", database)
+    assert sessions.verify(cookie, START) == 1
+
+    sessions.logout(1)
+    importlib.reload(sessions)
+    monkeypatch.setattr(sessions, "_connect", database)
+    assert sessions.verify(cookie, START) is None
+
+
+def test_cookie_expires_after_thirty_minutes(database):
+    cookie = sessions.sign(1, START)
+    assert sessions.verify(cookie, START + timedelta(minutes=29)) == 1
+    assert sessions.verify(cookie, START + timedelta(minutes=31)) is None
+
+
+def test_database_expiry_is_enforced(database):
+    cookie = sessions.sign(1, START)
+    with database() as connection:
