+import hashlib
+import json
+import logging
+import os
+from functools import lru_cache
+
+CACHE_TTL_SECONDS = 15
+logger = logging.getLogger(__name__)
+
+
+@lru_cache(maxsize=1)
+def _client(url: str):
+    # Redis is optional for deployments that leave the cache disabled.
+    from redis import Redis
+    from redis.backoff import NoBackoff
+    from redis.retry import Retry
+
+    return Redis.from_url(
+        url,
+        socket_connect_timeout=0.05,
+        socket_timeout=0.05,
+        retry=Retry(NoBackoff(), 0),
+    )
+
+
+def _cached_items(cache, key: str) -> list[dict] | None:
+    try:
+        value = cache.get(key)
+        if value is None:
+            return None
+        result = json.loads(value)
+        if isinstance(result, list) and all(
+            isinstance(item, dict)
+            and item.keys() == {"id", "name", "stock"}
+            for item in result
+        ):
+            return result
+    except Exception:
+        # Cache failures must not prevent a database read.
+        logger.warning("Catalog cache read failed; querying Postgres")
+    return None
+
+
 def items(conn, query: str) -> list[dict]:
     """The pantry items whose name matches the member's search, in name order."""
+    cache = None
+    url = os.environ.get("LARDER_REDIS_URL")
+    key = "larder:catalog:v1:" + hashlib.sha256(query.encode("utf-8")).hexdigest()
+    if url:
+        try:
+            cache = _client(url)
+        except Exception:
+            logger.warning("Catalog cache configuration failed; querying Postgres")
+        if cache is not None:
+            cached = _cached_items(cache, key)
+            if cached is not None:
+                return cached
+
     rows = conn.execute(
         "select id, name, stock from pantry_items"
         " where to_tsvector('simple', name) @@ plainto_tsquery('simple', %s) order by name",
         (query,),
     ).fetchall()
-    return [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    result = [{"id": r[0], "name": r[1], "stock": r[2]} for r in rows]
+    if cache is not None:
+        try:
+            cache.set(key, json.dumps(result), ex=CACHE_TTL_SECONDS)
+        except Exception:
+            logger.warning("Catalog cache write failed; returning Postgres results")
+    return result
