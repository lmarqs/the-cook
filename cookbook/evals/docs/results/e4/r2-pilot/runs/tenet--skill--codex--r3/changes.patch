@@ -0,0 +1,126 @@
+import json
+from decimal import Decimal
+from unittest.mock import Mock
+
+import pytest
+from larder import catalog
+
+
+@pytest.fixture
+def cache(monkeypatch):
+    cache = Mock()
+    cache.get.return_value = None
+    monkeypatch.setenv("LARDER_REDIS_URL", "redis://localhost:6379/0")
+    monkeypatch.setattr(catalog, "_client", Mock(return_value=cache))
+    return cache
+
+
+@pytest.fixture
+def conn():
+    conn = Mock()
+    conn.execute.return_value.fetchall.return_value = [(1, "Rice, brown", 12)]
+    return conn
+
+
+def test_without_configuration_queries_postgres(monkeypatch, conn):
+    monkeypatch.delenv("LARDER_REDIS_URL", raising=False)
+    client = Mock()
+    monkeypatch.setattr(catalog, "_client", client)
+
+    assert catalog.items(conn, "rice") == [{"id": 1, "name": "Rice, brown", "stock": 12}]
+    assert conn.execute.call_args.args[1] == ("rice",)
+    client.assert_not_called()
+
+
+def test_cache_miss_populates_an_expiring_entry_and_hit_skips_database(cache, conn):
+    expected = catalog.items(conn, "rice")
+    key, payload = cache.set.call_args.args
+    assert json.loads(payload) == expected
+    assert cache.set.call_args.kwargs == {"ex": catalog.CACHE_TTL_SECONDS}
+    cache.get.return_value = payload.encode()
+    conn.reset_mock()
+
+    assert catalog.items(conn, "rice") == expected
+    cache.get.assert_called_with(key)
+    conn.execute.assert_not_called()
+
+
+def test_empty_results_are_cache_hits(cache, conn):
+    cache.get.return_value = b"[]"
+
+    assert catalog.items(conn, "missing") == []
+    conn.execute.assert_not_called()
+
+
+def test_different_searches_have_different_keys(cache, conn):
+    catalog.items(conn, "rice")
+    first_key = cache.get.call_args.args[0]
+    catalog.items(conn, "Rice")
+
+    assert cache.get.call_args.args[0] != first_key
+
+
+@pytest.mark.parametrize("payload", [b"bad JSON", b"\xff", b"null", b"{}", b"[1]", b'[{}]'])
+def test_corrupt_cache_entries_fall_back_to_database(cache, conn, payload):
+    cache.get.return_value = payload
+
+    assert catalog.items(conn, "rice")[0]["stock"] == 12
+    conn.execute.assert_called_once()
+    cache.set.assert_called_once()
+
+
+@pytest.mark.parametrize("operation", ["get", "set"])
+def test_redis_failures_do_not_break_search(cache, conn, operation):
+    getattr(cache, operation).side_effect = ConnectionError("unavailable")
+
+    assert catalog.items(conn, "rice")[0]["name"] == "Rice, brown"
+    conn.execute.assert_called_once()
+
+
+@pytest.mark.parametrize("error", [ValueError("invalid URL"), ImportError("redis is not installed")])
+def test_bad_cache_configuration_falls_back_to_database(cache, conn, error):
+    catalog._client.side_effect = error
+
+    assert catalog.items(conn, "rice")[0]["stock"] == 12
+    cache.get.assert_not_called()
+
+
+def test_database_errors_propagate_and_are_not_cached(cache, conn):
+    conn.execute.side_effect = RuntimeError("database unavailable")
+
+    with pytest.raises(RuntimeError, match="database unavailable"):
+        catalog.items(conn, "rice")
+    cache.set.assert_not_called()
+
+
+def test_uncacheable_database_values_keep_their_original_types(cache, conn):
+    conn.execute.return_value.fetchall.return_value = [(1, "Rice, brown", Decimal("12.5"))]
+
+    assert catalog.items(conn, "rice")[0]["stock"] == Decimal("12.5")
+    cache.set.assert_not_called()
+
+
+def test_cache_failure_logs_do_not_include_credentials(cache, conn, caplog):
+    cache.get.side_effect = ConnectionError("redis://member:secret@localhost/0")
+
+    catalog.items(conn, "rice")
+
+    assert "Catalog cache read failed" in caplog.text
+    assert "secret" not in caplog.text
+
+
+def test_client_has_bounded_timeouts_and_no_retries(monkeypatch):
+    redis = pytest.importorskip("redis")
+    catalog._client.cache_clear()
+    factory = Mock()
+    monkeypatch.setattr(redis.Redis, "from_url", factory)
+    try:
+        client = catalog._client("redis://localhost:6379/0")
+        assert catalog._client("redis://localhost:6379/0") is client
+        factory.assert_called_once()
+        options = factory.call_args.kwargs
+        assert options["socket_connect_timeout"] == 0.05
+        assert options["socket_timeout"] == 0.05
+        assert options["retry"].get_retries() == 0
+    finally:
+        catalog._client.cache_clear()
