#!/bin/sh
# Usage: site/prepare <release tag>
# Readies a checkout for Jekyll to build the Pages site, run from its root: Jekyll reads its configuration only from
# the root of the source. The checkout is changed in place, so run it on a copy or a CI checkout.
set -eu

[ $# -le 1 ] || { echo 'usage: site/prepare [<release tag>]' >&2; exit 2; }
sed "s/^release:.*/release: ${1:-}/" site/_config.yml >_config.yml
