#!/bin/sh
# Runs the-cook @VERSION@. On first use it downloads the package for this machine, refuses it unless its sha256
# matches the one below, and caches it. Upgrade by replacing this file with the wrapper of another release.
set -eu

version='@VERSION@'
base_url='@BASE_URL@'
sha256_linux_x64='@SHA256_LINUX_X64@'
sha256_linux_arm64='@SHA256_LINUX_ARM64@'
sha256_macos_arm64='@SHA256_MACOS_ARM64@'

fail() {
  printf 'cook: %s\n' "$1" >&2
  exit 1
}

platform="$(uname -s) $(uname -m)"

case "$platform" in
  'Linux x86_64' | 'Linux amd64') target=linux-x64 expected=$sha256_linux_x64 image=cook/bin/cook ;;
  'Linux aarch64' | 'Linux arm64') target=linux-arm64 expected=$sha256_linux_arm64 image=cook/bin/cook ;;
  'Darwin arm64') target=macos-arm64 expected=$sha256_macos_arm64 image=cook.app/Contents/MacOS/cook ;;
  *) fail "the-cook has no package for $platform; it runs on Linux x64 and arm64 and macOS arm64" ;;
esac

versions="${XDG_CACHE_HOME:-$HOME/.cache}/the-cook/$version"
cache="$versions/$target"
launcher="$cache/$image"

if [ ! -x "$launcher" ]; then
  if command -v curl > /dev/null 2>&1; then
    download() { curl -fsSL -o "$2" "$1"; }
  elif command -v wget > /dev/null 2>&1; then
    download() { wget -q -O "$2" "$1"; }
  else
    fail 'downloading the-cook needs curl or wget'
  fi

  # Hashing standard input keeps the output free of the escaping sha256sum applies to some file names.
  if command -v sha256sum > /dev/null 2>&1; then
    sha256() { sha256sum < "$1" | cut -d ' ' -f 1; }
  elif command -v shasum > /dev/null 2>&1; then
    sha256() { shasum -a 256 < "$1" | cut -d ' ' -f 1; }
  else
    fail 'verifying the-cook needs sha256sum or shasum'
  fi

  command -v tar > /dev/null 2>&1 || fail 'unpacking the-cook needs tar'

  # The package unpacks beside the cache and moves in with one rename, so the cache never holds a partial package.
  mkdir -p "$versions"
  work=$(mktemp -d "$versions/.download.XXXXXX")
  trap 'rm -rf "$work"; rmdir "$versions" 2> /dev/null || :' EXIT
  trap 'exit 1' INT TERM
  package="the-cook-$version-$target.tar.gz"
  printf 'cook: downloading %s\n' "$package" >&2
  download "$base_url/$package" "$work/$package" || fail "cannot download $base_url/$package"
  actual=$(sha256 "$work/$package")

  if [ "$actual" != "$expected" ]; then
    fail "$package has sha256 $actual, not the $expected this wrapper pins; refusing to run it"
  fi

  mkdir "$work/package"
  tar -xzf "$work/$package" -C "$work/package"

  # Another run may have cached the package meanwhile and be running it, so a complete cache is kept as it is.
  if [ ! -x "$launcher" ]; then
    rm -rf "$cache"
    mv "$work/package" "$cache"
  fi

  rm -rf "$work"
  trap - EXIT
fi

exec "$launcher" "$@"
