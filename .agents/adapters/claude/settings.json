{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(./gradlew check *)",
      "Bash(./gradlew -p core check *)",
      "Bash(./gradlew -p infra check *)",
      "Bash(./gradlew -p cli check *)",
      "Bash(./gradlew -p docs check *)",
      "Bash(./gradlew -p cookbook check *)"
    ],
    "ask": [],
    "deny": [
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/session-start claude"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/worktree create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/worktree remove"
          }
        ]
      }
    ]
  }
}
