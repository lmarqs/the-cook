{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/.agents/hooks/session-start\" codex'",
            "statusMessage": "Loading session context"
          }
        ]
      }
    ]
  }
}
