prefix_rule(pattern = ["git", ["status", "diff", "log", "show", "add", "commit", "switch", "fetch", "pull", "push"]], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["view", "list", "diff", "checks", "create", "comment"]], decision = "allow")
prefix_rule(pattern = ["./gradlew", ["test", "check"]], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt")
prefix_rule(pattern = ["git", "push", ["--force", "-f"]], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
# Not enforced by Codex, Claude-only: git push * --force*
